function createMaroSleepyChatReplies(){
  var previousSleepy=false;
  return {
    requestContext:function(base,sleepy){return Object.assign({},base,{sleepy:sleepy===true,afterSleepy:previousSleepy});},
    decorate:function(result,sleepy){
      if(!result||typeof result.text!=='string'||!result.text.trim())return result;
      previousSleepy=sleepy===true;
      if(!sleepy)return result;
      var out=Object.assign({},result,{sleepy:true});
      if(result.voice!=='none')out.voice='sleepy';
      return out;
    }
  };
}
