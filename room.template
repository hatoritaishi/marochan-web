<script>
try{   // ねんね時間（21時〜翌8時）に開いたとき、本体スクリプトの実行前に一瞬だけ起きた姿が見えるのを防ぐ
  var __oneFootBoot=null;try{__oneFootBoot=JSON.parse(window.MaroPet&&MaroPet.balanceRead?MaroPet.balanceRead():localStorage.getItem('maro_one_foot_v1')||'null');}catch(__oneFootBootError){}
  window.__maroOneFootBootLocked=!!(__oneFootBoot&&(__oneFootBoot.helpAt?Date.now()<__oneFootBoot.helpEndAt:__oneFootBoot.outcome==='fall'||Date.now()<__oneFootBoot.returnEndAt));
  if(window.__maroOneFootBootLocked)document.documentElement.classList.add('maro-rescue-boot');
  var __nenneH = (new Date()).getHours();
  try{var __restSaved=JSON.parse(localStorage.getItem('maroSeatedRestV1')||'null');
  if(!window.__maroOneFootBootLocked&&__restSaved&&__restSaved.active&&Date.now()>=__restSaved.active.start&&Date.now()<__restSaved.active.end)document.documentElement.classList.add('maro-rest-boot');}catch(__restError){}
  if (!window.__maroOneFootBootLocked&&(__nenneH >= 21 || __nenneH < 8 || (__nenneH >= 10 && __nenneH < 19))) document.documentElement.classList.add('nenne-boot');
}catch(e){}
</script>
