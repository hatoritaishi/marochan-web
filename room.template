    if(maroSpeechMotion.kind==='curiosity'||maroSpeechMotion.kind==='screen-tap'){
      if(document.hidden||maroAndroidActive===false||!(maroCuriosityActive()||maroScreenTapActive())){
        maroSpeechMotion.until=0;maroSpeechMotion.kind='';return null;
