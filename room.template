  function canPetNow(){
    if(lateNightClosing(Date.now()))return false;
    if(petAnimationLocked())return false;
    if(snackPetLocked())return false;
    if (snackRequestActive()) return false;
    if (stealActive) return false;                     // つまみぐい中は なでなでを出さない（イベント専念）
    if (S.hold || S.happy > 0) return false;           // なでなで中は なでなで も出さない（終わったら おひるね・おやつ・しんこきゅう と一緒に戻る）
    if ((S.excited || S.excitedPending) && !barIdleSulking()) return false;   // おやつおねだり中（おやつしか出さない）。断られ「しゅん」中は通常顔と同じ出方
    return true;
  }
  // ── ねんねの時間帯まわり（自動入眠・ボタン切替・完全起床の判定はすべてここ） ──
  function inNenneAutoWindow(){ var h = (new Date()).getHours(); return h >= 21 || h < NENNE_WAKE_HOUR; }   // 自動ねんねの時間帯（21時〜翌8時）
  function nenneEventActive(){   // 一時起床中にイベントが動いているか（ねんねの再入眠を3秒待つかの判定。canStartNapと同じ種類の出来事）
    return maroCalm.breathing || eatActive || snackOpen || stealActive || urareFoundActive() || S.hold || S.happy > 0 || ((S.excited || S.excitedPending) && !barIdleSulking()) || snackDexOpen || snackBoxOpen;
  }
  function nenneBtnPeriod(){   // ボタンが「ねんね」になる条件：夜（19時〜翌8時）または ねんねセッション中（一時起床含む）
    if (napIsNenne) return true;
    var h = (new Date()).getHours(); return h >= 19 || h < NENNE_WAKE_HOUR;
  }
  function nenneNext8am(){   // 次に来る朝8時の絶対時刻（自動ねんねの終了時刻）
    var d = new Date(), t = new Date(d);
    t.setHours(NENNE_WAKE_HOUR, 0, 0, 0);
    if (t.getTime() <= d.getTime()) t.setDate(t.getDate() + 1);
    return t.getTime();
  }

  function canStartNap(restoreSleep){
    if(maroOutingRestBlocked()||lateNightActive(Date.now()))return false;
    return canStartMaroRoomAction(restoreSleep);
  }
  function canStartMaroRoomAction(restoreSleep){
    // Restore an already sleeping companion before considering queued movies.
    // Actual playback still owns the room; ordinary actions keep the full gate.
    if(typeof maroMovieBlocksAuto==='function'&&(restoreSleep?typeof maroMoviePlaying==='function'&&maroMoviePlaying():maroMovieBlocksAuto()))return false;
    if(maroOutingBlocked())return false;
    if(maroAndroidActive===false)return false;
    if(oneFootBlocked())return false;
    if(lateNightClosing(Date.now()))return false;
    if(snackDisappointedActive())return false;
    if(hasMaroSpeechMotion())return false;
    if(maroSoundOpen)return false;
    if(maroCalm.breathing) return false;   // おひるねを開始しない条件をすべてここで弾く（重要イベントの強制終了はしない）
    if (napActive || napTransitioning) return false;   // すでにおひるね中・出入り中
    if (eatActive || rerolling) return false;          // 食事中・おやつ入れ替え中
    if (snackOpen) return false;                       // 通常おやつバー表示中
    if (stealActive) return false;                     // つまみぐい中
    if (urareFoundActive()) return false;              // Uレア発見中
    if (S.hold || S.happy > 0) return false;           // なでなで中
    if ((S.excited || S.excitedPending) && !barIdleSulking()) return false;   // 喜び顔中・喜び顔予約中（断られ「しゅん」中は通常顔と同じ出方）
    if (snackDexOpen || snackBoxOpen) return false;                    // 図鑑などの大型モーダル表示中
    if (document.hidden) return false;                 // タブ非表示中
    if (chatBusy()) return false;   // おしゃべり入力中・返事表示中・その直後はねんねしない（一定時間入力がなければ寝る）
    return true;
  }

  function canShowSnackBtn(){
    if(maroOutingBlocked())return false;
    if(lateNightClosing(Date.now()))return false;
    if(isMaroNightWaking()||isMaroEveningDrowsy())return false;   // おやつボタンは おひるね・しんこきゅうと同じ優先度（なでなで中・つまみぐい中などは出さない）。ただし本物のおねだり中は「おやつ」だけ出す設計なので出したまま
    if ((S.excited || S.excitedPending) && !barIdleSulking()) return true;
    return canStartMaroRoomAction();
  }
  function canStartBreath(){
    if(lateNightClosing(Date.now()))return false;   // しんこきゅうを開始しない条件は おひるねとまったく同じ扱い（できる時だけボタンを出す）
    return canStartMaroRoomAction();
  }

  // One stable approved deep pose per sleep session, shared with native mini.
  function napImgKey(seg){ return napBlanketType + (seg==='deep'?'-deep-'+maroDeepSleepPose(napStartedAt):'-light'); }
  function napImageReady(key){
    var image=napImgs[key];
    return !!(image&&image.complete&&image.naturalWidth&&napDecodedSources.get(image)===image.src);
  }
  function napPictureVisible(){
    return napPos.style.opacity==='1'&&napImageReady(napPresentedKey);
  }
  function prepareNapImage(key){
    var image=napImgs[key];
    if(!image||!image.complete||!image.naturalWidth)return;
    var source=image.src;
    if(napDecodedSources.get(image)===source){presentNapImage(key);return;}
    if(napDecodingSources.get(image)===source)return;
    napDecodingSources.set(image,source);
    image.decode().then(function(){
      if(image.src!==source)return;
      napDecodingSources.delete(image);napDecodedSources.set(image,source);presentNapImage(key);
    },function(){if(image.src===source)napDecodingSources.delete(image);});
  }
  function presentNapImage(key){
    if(!napActive||napPhase==='wake'||napRequestedKey!==key||!napImageReady(key))return;
    var first=!napPictureVisible()||document.documentElement.classList.contains('maro-room-opening');
    // A decoded, opaque sleep portrait takes ownership in this one layout.
    // Until then the last painted body remains untouched, including on retry.
    if(first){napPos.style.transition='none';for(var k in napImgs)napImgs[k].style.transition='none';}
    for(var k in napImgs)napImgs[k].style.opacity=k===key?1:0;
    napPos.style.opacity=1;napPresentedKey=key;
    if(first){void napPos.offsetWidth;napPos.style.transition='';for(var k in napImgs)napImgs[k].style.transition='';}
    charwrap.style.visibility='hidden';charwrap.style.opacity=0;
  }
  function showNapImg(key){   // Decoded same-blanket light/deep changes retain the 500ms fade.
    napRequestedKey=key;prepareNapImage(key);
  }

  function unlockReopenedSleep(){
    if(!napActive||napPhase==='wake')return;
    napNoWakeUntil=0;
    if(napPhase==='enter'){
      clearTimeout(napFadeTimer);napFadeTimer=null;napTransitioning=false;
      napPhase=Date.now()>=napDeepAt?'deep':'light';showNapImg(napImgKey(napPhase));
      scheduleNapDeep();scheduleNapWake();scheduleNapSleepTalk();scheduleNapBubbles();
    }
    updateNapControls();syncActionButtons();
  }
  function syncSleepWakeLock(){
    var locked=!!(napTransitioning||(napActive?Date.now()<napNoWakeUntil:maroOutingBlocked()));
    cNapBtn.classList.toggle('sleep-wake-locked',locked);cNapBtn.disabled=locked;
    return locked;
  }
  function updateNapControls(){
    syncLateNightButton();
    syncSleepWakeLock();   // 睡眠中は起床操作、起きている間はお出かけ。睡眠開始は自動発生のみ。
    var img = cNapBtn.querySelector('img');
    var bedtimePet=isMaroBedtimePetting();
    img.src=bedtimePet?'media/31c2ad7dd218b7f20bbb0ec4.webp':napActive?SRC_WAKE_BTN:'media/maro-outing-button-v1.webp';
    cNapBtn.setAttribute('aria-label',bedtimePet?'なでなで':napActive?'おきる':maroOuting&&maroOuting.state().scene!=='home'?'おうちへかえる':'おでかけ');
    if(!bedtimePet&&!napActive&&maroOuting&&maroOuting.state().scene==='home')cNapBtn.setAttribute('aria-haspopup','dialog');else cNapBtn.removeAttribute('aria-haspopup');
    cNapBtn.dataset.destination=bedtimePet?'pet':napActive?'wake':maroOuting&&maroOuting.state().scene!=='home'?'home':'picker';
    // お出かけは従来の睡眠ボタンと同じ位置を使う。
    document.getElementById('cSnack').hidden = napActive||isMaroNightWaking();   // 睡眠中はおやつを隠し、お出かけを無効にする。
    // しんこきゅうボタンの表示切替はここでは触らない（ループ内の canStartBreath 判定で おひるねと同じ nap-gone 方式に統一）
    snackRows[1].hidden = (napActive&&document.getElementById('cLateNight').hidden) || snackOpen;   // おひるね中は下段を行ごと隠す（あそびかた・おやつ両方が隠れる行のため）
  }

  function startNap(asNenne, nenneEnd, keepBlanket, instant, savedSession, restoreSleep){
    document.documentElement.classList.remove('maro-rest-boot');   // ねんねもこの枠組みで動く（asNenne=true。ねんね中の操作制限はおひるねと同じ）
    if (!canStartNap(restoreSleep)) return;
    stopMaroSoundSpeech();   // Sleep owns speech: cancel any awake clip, delayed voice switch and queued line.
    if(asNenne&&!keepBlanket)maroDailyMemories.bedtime({night:true,at:Date.now(),source:instant?'restore':'room'});
    closeMaroChat(false);
    cancelAutoTalkStep2();                 // おひるね開始で自動会話の二段目は必ずキャンセル
    if(!asNenne&&!savedSession)savedSession=maroDayNapStore.restore(Date.now())||maroDayNapStore.resume(Date.now(),true);
    if(asNenne&&maroDayNapStore.paused(Date.now()))maroDayNapStore.finish(Date.now());
    maroActivityBreak.settle(Date.now(),asNenne?'night':'nap');
    maroWakeRecovery.clear();
    napActive = true;
    resetSnackBarUru();
    napIsNenne = !!asNenne;
    if (napIsNenne){ nenneEndAt = nenneEnd; nenneTempWakeUntil = 0; if (!keepBlanket) nenneStealOk = false; }   // ねんねの完全起床時刻をセッションに記録（再入眠ではタイマー・抽選をリセットしない）
    if (!instant) napTransitioning = true;
    napPhase = 'enter';
    if (!keepBlanket) napBlanketType = (Math.random() < NAP_RARE_CHANCE) ? 'rare' : 'normal';   // 毛布抽選はセッション開始時の1回だけ（起床まで固定。水玉⇔花柄の途中変更なし。ねんねの再入眠では前の柄を引き継ぐ）
    var now = Date.now();
    napStartedAt = savedSession ? savedSession.start : now;
    if(savedSession)napBlanketType=savedSession.blanket;
    napNoWakeUntil = instant ? 0 : napStartedAt + 30000; // Restored sleep is immediately wakeable; new sleep waits 30 seconds.
    napLightAt = 0;
    napDeepAt = now + (napIsNenne ? randomInt(NENNE_PHASE_MIN, NENNE_PHASE_MAX) : randomInt(NAP_LIGHT_MIN, NAP_LIGHT_MAX));   // 睡眠時間の決定も1回だけ・絶対時刻で記録
    napWakeAt = napIsNenne ? nenneEndAt : now + randomInt(NAP_TOTAL_MIN, NAP_TOTAL_MAX);   // ねんねの自動起床はセッションの完全起床時刻
    if(!napIsNenne){
      if(savedSession){napDeepAt=savedSession.deep;napWakeAt=savedSession.end;}
      maroDayNapStore.record(Object.assign({},savedSession||{},
        {start:napStartedAt,end:napWakeAt,deep:napDeepAt,blanket:napBlanketType,
        source:savedSession?savedSession.source:'manual'}),now);
    }
    clearTimeout(blinkTimer);              // 睡眠PNG自体が目を閉じているため、おひるね中だけ自動まばたきを一時停止（機能自体は削除しない）
    S.blinkT = null; S.blinkCb = null; S.open = 1;   // 進行中のまばたきは開いた状態へ戻す（起床後の顔が中途半端にならないように）
    showNapImg(napImgKey(instant&&!napIsNenne&&now>=napDeepAt?'deep':'light'));
    updateNapControls();
    if (instant){   // 21時以降に開いた時など：クロスフェードなしで最初から寝た状態で始める。出迎えセリフは寝言
      napPhase = !napIsNenne&&now>=napDeepAt?'deep':'light';
      showNapImg(napImgKey(napPhase));
      say(pick(napPhase==='deep'?NAP_SLEEPTALK_DEEP:NAP_SLEEPTALK));
      scheduleNapDeep();
      scheduleNapWake();
      scheduleNapSleepTalk();
      scheduleNapBubbles();
      syncMaroPetSleep(true);
      return;
    }
    say(pick(napIsNenne ? NENNE_START : NAP_START));   // 入眠の一言は1回の睡眠につき1つだけ（ねんねは「おひるね」と言わないプール）
    napFadeTimer = setTimeout(function(){
      napFadeTimer = null;
      if (!napActive) return;
      napPhase = 'light';                  // NAP_LIGHT 開始
      napTransitioning = false;
      scheduleNapDeep();
      scheduleNapWake();
      scheduleNapSleepTalk();
      scheduleNapBubbles();
    }, NAP_FADE_MS);
    syncMaroPetSleep(true);
  }

  function scheduleNapDeep(){
    clearTimeout(napDeepTimer);
    napDeepTimer = setTimeout(function(){
      napDeepTimer = null;
      if (!napActive || napPhase !== 'light') return;
      if (Date.now() < napDeepAt - 60){ scheduleNapDeep(); return; }   // 早発火なら残りを待ち直す（絶対時刻が正）
      startNapDeep();
    }, Math.max(0, napDeepAt - Date.now()));
  }
  function startNapDeep(){
    if(maroSoundOpen)return;   // 浅寝→深寝：同じ毛布タイプのままクロスフェード（水玉→花柄・花柄→水玉の途中変更はしない）
    if (!napActive || napTransitioning || napPhase !== 'light') return;
    napTransitioning = true;               // フェード中は呼吸を止めてscale 100%へ戻す（ループ側が振幅0へ追従）
    showNapImg(napImgKey('deep'));
    napFadeTimer = setTimeout(function(){
      napFadeTimer = null;
      if (!napActive) return;
      napPhase = 'deep';                   // NAP_DEEP 開始（完了後に呼吸再開）
      napTransitioning = false;
      if (napIsNenne){                     // ねんねは深寝で終わらず、30分〜1時間後に浅寝へ戻るループ
        napLightAt = Date.now() + randomInt(NENNE_PHASE_MIN, NENNE_PHASE_MAX);
        scheduleNapLight();
      }
    }, NAP_FADE_MS);
  }

  function scheduleNapLight(){   // ねんね専用：深寝→浅寝の戻り予約（おひるねでは使わない）
    if (!napIsNenne || !napLightAt) return;
    clearTimeout(napLightTimer);
    napLightTimer = setTimeout(function(){
      napLightTimer = null;
      if (!napActive || napPhase !== 'deep') return;
      if (Date.now() < napLightAt - 60){ scheduleNapLight(); return; }   // 早発火なら残りを待ち直す（絶対時刻が正）
      startNapLight();
    }, Math.max(0, napLightAt - Date.now()));
  }
  function startNapLight(){
    if(maroSoundOpen)return;   // ねんね専用：深寝→浅寝へ同じ毛布タイプのままクロスフェードで戻る
    if (!napActive || napTransitioning || napPhase !== 'deep') return;
    napTransitioning = true;
    showNapImg(napImgKey('light'));
    napFadeTimer = setTimeout(function(){
      napFadeTimer = null;
      if (!napActive) return;
      napPhase = 'light';
      napTransitioning = false;
      napLightAt = 0;
      napDeepAt = Date.now() + randomInt(NENNE_PHASE_MIN, NENNE_PHASE_MAX);   // 浅寝に戻ったら次の深寝を30分〜1時間後に予約（ループ）
      scheduleNapDeep();
    }, NAP_FADE_MS);
  }

  function scheduleNapWake(){
    clearTimeout(napWakeTimer);
    napWakeTimer = setTimeout(function(){
      napWakeTimer = null;
      if (!napActive || napPhase === 'wake') return;
      if (Date.now() < napWakeAt - 60){ scheduleNapWake(); return; }
      wakeNap();                           // 自動起床（手動「おきる」と同じ処理）
    }, Math.max(0, napWakeAt - Date.now()));
  }

  function scheduleNapSleepTalk(){
    clearTimeout(napTalkTimer);
    napTalkTimer = setTimeout(function(){
      napTalkTimer = null;
      if (!napActive) return;
      if (!napTransitioning && napPhase === 'light') say(pick(NAP_SLEEPTALK));          // 浅寝：寝言プール全体から低頻度で
      else if (!napTransitioning && napPhase === 'deep') say(pick(NAP_SLEEPTALK_DEEP)); // 深寝：短い寝言だけ
      scheduleNapSleepTalk();
    }, randomInt(NAP_TALK_MIN, NAP_TALK_MAX));
  }

  function scheduleNapBubbles(){
    clearTimeout(napBubbleTimer);
    napBubbleTimer = setTimeout(function(){
      napBubbleTimer = null;
      if (!napActive) return;
      if (!napTransitioning && (napPhase === 'light' || napPhase === 'deep') && Date.now() - napLastBubbleAt >= NAP_BUBBLE_COOLDOWN){
        napLastBubbleAt = Date.now();
        spawnNapBubbles(randomInt(NAP_BUBBLE_COUNT_MIN, NAP_BUBBLE_COUNT_MAX));   // 頭の少し上から数個（大量発生はしない）
      }
      scheduleNapBubbles();
    }, randomInt(NAP_BUBBLE_MIN, NAP_BUBBLE_MAX));
  }

  function spawnNapBubbles(n){   // 既存のなでなで用シャボン玉素材を流用（新規素材なし・見た目は変更しない）
    if (!fxLayer || oneFootBlocked()) return;
    var box = getCharBox();
    if (!box.w || !box.h) return;
    var used = {}, made = 0, guard = 0;
    while (made < n && guard++ < 20){
      var big = (made === 0 && Math.random() < 0.30);   // 先頭の1個だけ時々大きめ（既存の大シャボン玉素材）
      var a = pickPetEffectAsset(big ? 'bubbleBig' : 'bubble', used);
      if (!a) break;
      used[a.id] = (used[a.id] || 0) + 1;
      if (createPetParticle(a, big ? PET_MOTION.napBubbleBig : PET_MOTION.napBubble, box, { side:'NAP', zoneIndex:0 }, randomInt(0, 900))) made++;
    }
  }

  function napPet(){   // おひるね中のなでなで：起きない・目は閉じたまま・睡眠画像と毛布とphaseを維持（通常pet()のフルエフェクトは使わない）
    if (!napActive || napTransitioning) return;
    if (napPhase !== 'light' && napPhase !== 'deep') return;
    rememberMaroPetting();
    say(pick(NAP_PETTED));   // 寝言と共通の待ち時間・音声の再生完了を表示時に確認（泡は引き続き反応する）
    if (Date.now() - napLastBubbleAt >= NAP_BUBBLE_COOLDOWN){   // 共通クールタイム中は泡は省略（セリフとは別の従来クールタイム）
      napLastBubbleAt = Date.now();
      spawnNapBubbles(randomInt(NAP_PET_BUBBLE_COUNT_MIN, NAP_PET_BUBBLE_COUNT_MAX));   // 頭周辺から少量（2〜3個）だけ
    }
  }

  function wakeNap(){
    if(maroSoundOpen)return;
    if(!napActive || napPhase==='wake')return;
    if(Date.now()<napNoWakeUntil&&Date.now()<napWakeAt)return;
    if(!napIsNenne)maroDayNapStore.interrupt(Date.now());
    spriteInterruptedWake=Date.now()<(napIsNenne?nenneEndAt:napWakeAt)-1000;
    spriteSleepyUntil=0;spriteWakePrepared=false;
    beginWakeRecovery(spriteInterruptedWake);
    napTransitioning=true;napPhase='wake';syncSleepWakeLock();clearNapTimers();
    // Keep the sleeping picture visible until the waking canvas has its first pose.
    var prepareSerial=napWakePrepareSerial;
    var stillCurrent=function(){return prepareSerial===napWakePrepareSerial&&napActive&&napPhase==='wake';};
    var beginWake=function(){
      if(!stillCurrent())return;
      if(window.maroReportLoadFailure)window.maroReportLoadFailure('wake-prepare',false);
      spriteWakePrepared=true;
      spriteSleepyUntil=0;
      charwrap.style.visibility='';
      napPos.style.opacity=0;charwrap.style.opacity=1;
      napFadeTimer=setTimeout(finishNapWake,NAP_FADE_MS);
    };
    maroMotion.prepareWake(spriteInterruptedWake,stillCurrent).then(beginWake,function(error){
      // Retain the sleeping picture and deadlines; expose a data-preserving retry.
      if(stillCurrent()&&window.maroReportLoadFailure)window.maroReportLoadFailure('wake-prepare',true);
      console.error(error);
    });
  }
  function finishNapWake(){
    napFadeTimer = null;napWakePrepareSerial++;
    napActive = false;
    napTransitioning = false;
    napPhase = 'awake';
    if(napIsNenne)maroActivityBreak.restart(Date.now());
    napStartedAt = napDeepAt = napWakeAt = napLightAt = 0;
    S.blinkT = null; S.blinkCb = null; S.open = 1;   // 顔は必ず開いた状態から
    var now = Date.now();
    var beforeBedWake=napIsNenne&&now<nenneEndAt&&!inNenneAutoWindow();
    if(beforeBedWake){
      // A manual sleep before 21:00 ends when woken. Keep the short sleepy
      // recovery, then stand awake until the normal bedtime schedule takes over.
      maroRestStore.finishForSnack(now);maroRestSession=null;maroRestActivated=false;
      recordMaroRestEnd(now,'night');
    }
    if(napIsNenne&&now>=nenneEndAt)recordMaroRestEnd(nenneEndAt,'night');
    spriteSleepyUntil=0;
    spriteWakePrepared=false;
    spriteInterruptedWake=false;
    lastUserAction = now;                  // おひるね時間を放置時間として扱わない（起床直後のイベント暴発防止）
    stealNextRollAt = null; stealNextRollBase = null;   // つまみぐいの次回予約は「今起きた」時点から数え直す
    clearTimeout(stealFireTimer); stealFireTimer = null;   // 睡眠中に届いた発動予約（2秒再試行ループ含む）を止める。これが残っていると起床直後に即発動してしまう。数え直しは見張りティックに任せる
    excitedCooldownUntil = now + EXCITED_COOLDOWN;      // 喜び顔もすぐには始めない
    if (napIsNenne && now < nenneEndAt && !beforeBedWake){
      // ねんね中の「おきる」は一時起床：3〜5分だけ起きていて、その後また自動で寝始める
      // 起きている時間も睡眠時間に含まれる（完全起床時刻 nenneEndAt はずれない・再入眠でリセットもされない）
      var invitation=lateNightSession();
      nenneTempWakeUntil = lateNightActive(now)?Math.min(invitation.sleepAt,invitation.nightEnd):now + randomInt(NENNE_WAKE_MIN, NENNE_WAKE_MAX);
      nenneLastEventAt = 0;                             // この一時起床ではまだイベントなし（再入眠の3秒ルールはここから数える）
      nenneStealOk = false;
      updateNapControls();
      say(pickWakeLine(now),4200);          // 起こされたときは「ねんねしようね」系のセリフ
      scheduleBlink();
      syncMaroPetSleep(true);
      return;
    }
    if(napIsNenne&&maroNightLetterMovie)maroNightLetterMovie.woke();
