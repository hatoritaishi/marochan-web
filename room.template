    0%{opacity:0;transform:translate(-50%,-50%) translate(calc(var(--ax) * 0.0000),calc(var(--ay) * 0.0000)) rotate(var(--rot)) scale(0.350)}
    2%{opacity:calc(var(--op) * 0.064);transform:translate(-50%,-50%) translate(calc(var(--ax) * 0.1859),calc(var(--ay) * 0.0322)) rotate(var(--rot)) scale(0.445)}
