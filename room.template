.maro-memory-paper{position:relative;padding:22px 38px 28px;border:1px solid #e4cebd;border-top:5px solid #e8b0be;border-radius:5px 5px 18px 18px;background:#fffdf7;box-shadow:0 5px 18px #ad7d621c}.maro-letter-heading{position:relative;display:flex;align-items:center;gap:12px;min-height:128px;margin-bottom:24px;padding-bottom:18px;border-bottom:1px dashed #dbb6ac}.maro-letter-portrait{flex:none;width:112px;height:112px;object-fit:contain}.maro-letter-portrait[hidden]{display:none}.maro-letter-note{min-width:0}.maro-letter-from{margin:0 0 8px;color:#885166;font-size:17px;font-weight:700;line-height:1.7}.maro-letter-date{display:block;color:#72544c;font-size:14px;line-height:1.8}.maro-letter-delivered{margin:4px 0 0;color:#82645c;font-size:12px;line-height:1.6}
