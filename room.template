function createMaroDayNapStore(storage, random) {
  var key='maroDayNapV1', state=null, minute=60000;
  function dayKey(now){var d=new Date(now);return d.getFullYear()+'-'+(d.getMonth()+1)+'-'+d.getDate();}
  function save(){try{storage.setItem(key,JSON.stringify(state));}catch(e){}}
  function validSession(s){return s&&Number.isFinite(s.start)&&Number.isFinite(s.end)&&
    Number.isFinite(s.targetMs)&&s.targetMs>=15*minute&&s.targetMs<=30*minute&&
    Number.isFinite(s.sleptMs)&&s.sleptMs>=0&&s.sleptMs<s.targetMs&&
    Number.isFinite(s.deep)&&s.deep>=s.start&&['normal','rare'].indexOf(s.blanket)!==-1&&
    (s.phase==='sleep'&&s.end-s.start===s.targetMs-s.sleptMs||
     s.phase==='pause'&&Number.isFinite(s.resumeAt)&&s.resumeAt>=s.start);}
  function complete(s,now){recordMaroRestEnd(now,'nap');s.active=null;s.cooldownUntil=now+45*minute;
    s.slots.forEach(function(slot){if(slot.start<s.cooldownUntil&&slot.end>now)slot.done=true;});save();}
  function ensure(now){
    if(!state){try{state=JSON.parse(storage.getItem(key)||'null');}catch(e){}}
    var date=dayKey(now), d=new Date(now);d.setHours(10,0,0,0);var from=d.getTime();d.setHours(19,0,0,0);var to=d.getTime();
    if(!state||state.date!==date||!Array.isArray(state.slots)||state.slots.length<2||state.slots.length>3||
      !state.slots.every(function(s){return Number.isFinite(s.start)&&Number.isFinite(s.end)&&s.start>=from&&s.end<=to&&s.end-s.start>=15*minute&&s.end-s.start<=30*minute;})){
      var count=random()<0.5?2:3, slots=[],span=(to-from)/count;
      for(var i=0;i<count;i++){
        var start=from+i*span+15*minute+Math.floor(random()*(span-60*minute));
        slots.push({id:date+':'+i,start:start,end:start+(15+Math.floor(random()*16))*minute,done:false});
      }
      state={date:date,slots:slots,active:null,cooldownUntil:0};save();
    }
    if(!Number.isFinite(state.cooldownUntil))state.cooldownUntil=0;
    if(state.active&&!state.active.phase){
