    var mobile = window.matchMedia('(max-width:480px)').matches;

    // セリフごとの見た目の差を抑えるため、文字数ではサイズを変えない。
    // 毎回ほぼ同じ基準サイズから開始し、本当に枠へ収まらない時だけ最小限縮小する。
    var size = mobile ? 17 : 18.5;
    var minSize = mobile ? 9.5 : 11.5;
    bubble.style.fontWeight = 500;
    bubble.style.letterSpacing = '.01em';
    bubble.style.fontSize = size + 'px';

    var st = window.getComputedStyle(bubble);
    var available = bubble.clientWidth
      - (parseFloat(st.paddingLeft) || 0)
      - (parseFloat(st.paddingRight) || 0);
    if (available <= 0) return;

    var w = measureTextWidth(bubble);

    // まず文字間隔だけ少し詰めて、できるだけ文字サイズを揃える。
    if (w > available){
      bubble.style.letterSpacing = '0';
      w = measureTextWidth(bubble);
    }

    // それでも入らない長文だけ0.25px刻みで必要な分だけ縮小。
    while (w > available && size > minSize){
      size = Math.max(minSize, size - 0.25);
      bubble.style.fontSize = size + 'px';
      w = measureTextWidth(bubble);
    }
  }
  function fitFootText(){
