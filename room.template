  // 等間隔で打つとスクリーンセーバーに見える。生き物のまばたきは
  //   ・かたまって出る（2回続けてから長く空く）
  //   ・深さが毎回ちがう（6割しか閉じない半まばたきが混ざる）
  //   ・出来事に引きずられる（話し出した拍子、触られた瞬間）
  //   ・場面で頻度が変わる（おねだり中は速く、なでなで直後はゆっくり）
  function blink(cb, opt){
    opt = opt || {};
    if (napActive) return false;          // おひるね中は睡眠PNG自体が目を閉じているため一時停止（機能自体は維持・起床後に再開）
    if (eatActive && !opt.force) return false;   // おやつ演出〜ロック中はまばたき無効
    if (S.hold && !opt.force) return false;      // なでなで中はまばたきしない（優先度: petting > blinking）
    if (S.blinkT !== null) return false;
    S.blinkDepth = opt.depth || 1;
    S.blinkSpeed = opt.speed || 1;
    S.blinkT = performance.now(); S.blinkCb = cb || null;
    return true;
  }
  function blinkKind(){
    var r = Math.random();
    if (r < .14) return { depth: .52 + Math.random() * .20, speed: 1.25 + Math.random() * .40 };   // 半まばたき：浅くて速い
    if (r < .48) return { depth: 1,                         speed:  .60 + Math.random() * .20 };   // ゆっくり深く
    return        { depth: .88 + Math.random() * .12,       speed:  .92 + Math.random() * .32 };   // ふつう
  }
  function blinkGap(){
    if (S.excited || snackOpen)                      return 2800 + Math.random() * 3600;   // おねだり中も、落ち着いたまばたき
    if (S.hold || Date.now() - lastPet < 5500)       return 3600 + Math.random() * 5400;   // なでなで直後はゆっくり
    return GAP[0] + Math.random() * (GAP[1] - GAP[0]);
  }
  function scheduleBlink(){
    clearTimeout(blinkTimer);
    blinkTimer = setTimeout(function(){
      var started = blink(function(){
        if (Math.random() < .16){                    // かたまって出る：2回続けてから、次までは長く空く
          setTimeout(function(){ blink(null, blinkKind()); scheduleBlink(); }, 150 + Math.random() * 190);
        } else scheduleBlink();
      }, blinkKind());
      if (!started) scheduleBlink();                 // 出せない状況でも予約は続ける（まばたきが止まらないように）
    }, blinkGap());
  }
  function blinkOnEvent(chance, delay, opt){         // 出来事に引きずられて出るまばたき
    if (Math.random() >= chance) return;
    setTimeout(function(){ blink(null, opt || blinkKind()); }, delay);
  }
