.maro-letter-illustration{width:min(100%,280px);margin:1.4em auto 1.6em;break-inside:avoid}.maro-letter-drawing{display:grid;place-items:center;width:100%;aspect-ratio:1;border:1px dashed #e2c7b8;border-radius:12px;background:#fffaf0;overflow:hidden}.maro-letter-drawing.is-pending{color:#c58c9e;font-size:40px}.maro-letter-doodle{display:block;width:100%;height:100%;object-fit:contain}.maro-letter-doodle.is-keepsake{width:72%;height:72%}.maro-letter-doodle-caption{margin:9px 0 0;text-align:center;color:#956676;font-size:14px;line-height:1.7;letter-spacing:.02em}
