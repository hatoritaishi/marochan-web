      s.phase='pause';s.resumeAt=now+3*minute+Math.floor(random()*2*minute);save();},
    due:function(now){var s=ensure(now);if(s.active||now<s.cooldownUntil)return null;
      return s.slots.find(function(slot){return !slot.done&&slot.start<=now&&now<slot.end;})||null;},
    record:function(session,now){var s=ensure(now);
      s.active=Object.assign({targetMs:session.end-session.start,sleptMs:0,phase:'sleep'},session);
