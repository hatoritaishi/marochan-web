  function displayBubbleSpeech(speech){
    if(maroOutingBlocked()&&!(speech.outingCue&&maroOuting.state().cue===speech.outingCue))return;
    if(isMaroConversationSource(speech.source)&&petTalkLocked())return;
    if(maroCuriosityActive()||maroScreenTapActive())return;
    if(oneFootBlocked())return;
    if(document.documentElement.classList.contains('maro-room-opening')){pendingBubbleSpeech=speech;return;}
    stopMaroPawWaveCelebration();
    if(!speech.gameProudPeak)cancelMaroGameProud();
    cancelMaroIdleGesture();
    if(maroSoundOpen)return;
    if(maroCalm.breathing||(chatBusy()&&!speech.chat)) return;
    // Sleep talk and pet replies share one admission point, including delayed fonts.
    // Drop overlapping requests instead of replaying stale lines in a queue.
    var sleeping=napActive&&napPhase!=='wake';
    if(sleeping){
      // A queued awake line must not survive a sleep handoff or delayed fonts.
      if(NAP_SLEEPTALK.indexOf(speech.text)===-1&&NAP_PETTED.indexOf(speech.text)===-1&&
         !(napPhase==='enter'&&NAP_START.indexOf(speech.text)!==-1))return;
      if(document.hidden||maroAndroidActive===false||Date.now()<napSpeechUntil)return;
      if(voiceOn!==false&&(maroVoiceSwitchTimer!=null||
         (currentMaroVoiceAudio&&!currentMaroVoiceAudio.paused&&!currentMaroVoiceAudio.ended)))return;
    }
    if(isMaroDrowsy()&&!speech.chat&&PET_BEG.indexOf(speech.text)!==-1){
      speech=Object.assign({},speech,{text:pickWakeLine(Date.now()),voice:'sleepy'});
    }
    // Resolve greetings and delayed fonts at display time, within the awake hour.
    if(lateNightAwake(Date.now())&&speech.source==='greeting'&&!speech.chat&&!maroLateNightSpeechMotion(speech)){
      speech=Object.assign({},speech,{text:pick(maroLateNightPool([],'paw-greeting','greeting'))});
    }
    if(!speech.chat&&MARO_LATE_NIGHT_DIALOGUE.concat(MARO_EARLY_WAKE_DIALOGUE).some(function(entry){return entry.text===speech.text;})&&
       !maroLateNightSpeechMotion(speech))return;
    speech=prepareSeatedRestSpeech(speech);
    requestSeatedTalkFaceForSpeech(speech);
    requestSeatedYawnForSpeech(speech);
    if(!speech.chat&&typeof maroDialogueRules!=='undefined'&&!maroDialogueRules.commit(speech.text,maroDialogueContext(speech.source||'talk',speech.text)))return;
    // Hide without display:none so the final font can be measured before paint.
    bubble.classList.remove('on');
    bubble.style.transition='none';bubble.style.opacity='0';
    bubble.textContent=speech.text;
    bubble.dataset.petSpeech=speech.source==='pet'||speech.source==='rest-pet'?'true':'';
    syncSleepySpeech(speech);
    bubble.dataset.snackMood=isWaterySnackLine(speech.text)?'uru':'';
