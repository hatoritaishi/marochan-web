      return maroSpeechMotion;
    }
    if(maroSpeechMotion.kind==='game-proud'&&(!canContinueMaroGameProud()||Date.now()>=maroSpeechMotion.until))cancelMaroGameProud();
    if(maroSpeechMotion.kind==='paw-greeting'&&(!canMaroPawGreetingAnimate()||!bubble.classList.contains('on'))){
