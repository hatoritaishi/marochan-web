  /* ── 操作（かわいい画像ボタン） ─────────── */
  .chips{display:flex;flex-direction:column;align-items:center;gap:4px;margin-top:6px}
  .action-row{width:100%;display:flex;justify-content:center;align-items:flex-start;gap:12px}
  .action-row2{margin-top:0}
  .action-row .cute-action-button[hidden]{display:none}
  .action-row[hidden]{display:none}                       /* おやつモード中はボタン行を隠す（display:flexがUAのhiddenを上書きするため明示） */   /* おひるね中は おやつ・あそびかた をボタン単位で隠す（display指定がUAのhiddenを上書きするため明示） */
  #snackBar{position:relative;width:min(100%,340px);aspect-ratio:3/2}   /* 横長おやつバー（ボタンエリアと入れ替え。キャラとは構造上重ならない） */
  #snackBar>img{position:absolute;left:-5%;top:0;width:110%;height:100%;display:block;pointer-events:none}   /* 横だけ1.1倍に伸ばす（高さは据え置き＝画面収支に影響なし） */
  .snack-slot{position:absolute;top:50.2%;width:28.64%;aspect-ratio:1/1;transform:translate(-50%,-50%);background:transparent;border:0;padding:0;cursor:pointer;-webkit-tap-highlight-color:transparent;transition:opacity .18s ease}
  .snack-slot img{display:block;width:100%;height:100%;pointer-events:none}
  .snack-slot:active{transform:translate(-50%,-50%) scale(.94)}
  #snackBar.eating .snack-slot{pointer-events:none;opacity:.55}   /* モグモグ〜感想の間は押せない見た目に（「押せたのに無視」を防ぐ） */
  #snackSlot0{left:17.8%}#snackSlot1{left:50%}#snackSlot2{left:82.4%}   /* 横1.1倍のアフィン変換後の実測位置 */
  #snackClose{position:absolute;left:36.76%;top:85.35%;width:26.5%;height:14.26%;background:transparent;border:0;padding:0;cursor:pointer;-webkit-tap-highlight-color:transparent}
#snackClose::before{content:"";position:absolute;left:-20%;top:-10%;right:-20%;bottom:-20%}
#snackClose img{display:block;width:100%;height:100%;pointer-events:none}
#snackClose:active img{transform:scale(.94)}
  #snackClose:disabled{cursor:default}

  /* ── つまみぐい専用バー（通常バーと同じ構造・同じ寸法。おやつは中央に1個だけ） ── */
  #stealBar{position:relative;width:min(100%,340px);aspect-ratio:3/2}
  #stealBar>img{position:absolute;left:-5%;top:0;width:110%;height:100%;display:block;pointer-events:none}
  #stealSlot{left:50%}   /* クラスは .snack-slot 共通。中央に1個だけ配置 */
  #stealBar.eating .snack-slot{pointer-events:none;opacity:.55}   /* モグモグ中は通常バーと同じ見た目に */
  #stealFxLayer{position:absolute;inset:0;pointer-events:none;overflow:visible}
  #stealClose{position:absolute;left:36.76%;top:85.35%;width:26.5%;height:14.26%;background:transparent;border:0;padding:0;cursor:pointer;-webkit-tap-highlight-color:transparent}
  #stealClose::before{content:"";position:absolute;left:-20%;top:-10%;right:-20%;bottom:-20%}
  #stealClose img{display:block;width:100%;height:100%;pointer-events:none}
  #stealClose:active img{transform:scale(.94)}
  #stealClose:disabled{cursor:default}
  .snack-slot.askwait img{animation:askPulse 1.1s ease-in-out infinite}   /* 「食べていい？」待ち：タップしてねの合図にふわふわ脈動 */
  @keyframes askPulse{0%,100%{transform:scale(1);filter:drop-shadow(0 0 4px rgba(255,210,120,.55))}50%{transform:scale(1.07);filter:drop-shadow(0 0 10px rgba(255,205,90,.95))}}

  /* ── レアデザート：パネルのキラキラとランク演出 ─────────── */
  #snackFxLayer{position:absolute;inset:0;pointer-events:none;overflow:visible}   /* タップを妨げない。少しだけパネルの外へはみ出す */
  .snack-sparkle{position:absolute;opacity:0;pointer-events:none;line-height:0;
    animation:snackTwk var(--dur,1100ms) ease-out forwards}
  .snack-sparkle img{display:block;pointer-events:none;animation:snackKira var(--dur,1100ms) ease-out forwards}
  @keyframes snackTwk{   /* 小さく出現→外側へふわっと移動→きらっ→なめらかにフェードアウト */
    0%{opacity:0;transform:translate(-50%,-50%) scale(.3) rotate(0deg)}
    18%{opacity:.95;transform:translate(calc(-50% + var(--dx)*.25),calc(-50% + var(--dy)*.25)) scale(1) rotate(var(--rot))}
    58%{opacity:.95;transform:translate(calc(-50% + var(--dx)*.6),calc(-50% + var(--dy)*.6)) scale(1.06) rotate(var(--rot))}
    72%{opacity:.55}
    100%{opacity:0;transform:translate(calc(-50% + var(--dx)),calc(-50% + var(--dy))) scale(.9) rotate(var(--rot))}
  }
  @keyframes snackKira{0%,45%{filter:brightness(1)}58%{filter:brightness(1.45)}100%{filter:brightness(1)}}
  .snack-sparkle.tint-gold{filter:sepia(1) saturate(2.2) hue-rotate(-8deg) brightness(1.03)}   /* キラキラのみ金色寄り（パネル画像は無加工） */
  .snack-sparkle.tint-rainbow{animation:snackTwk var(--dur,1100ms) ease-out forwards,snackHue 2.8s linear infinite}
  @keyframes snackHue{to{filter:hue-rotate(360deg)}}
  .snack-slot.fx-srare img{animation:glowPulseS 1.6s ease-in-out infinite}   /* フチの淡い明滅（外側の光） */
  @keyframes glowPulseS{0%,100%{filter:drop-shadow(0 0 3px rgba(190,140,255,.45))}50%{filter:drop-shadow(0 0 8px rgba(190,140,255,.85))}}
  .snack-slot.fx-ssrare img{animation:glowPulseG 1.3s ease-in-out infinite}   /* 紫より強い金色の光 */
  @keyframes glowPulseG{0%,100%{filter:drop-shadow(0 0 5px rgba(255,205,90,.6))}50%{filter:drop-shadow(0 0 11px rgba(255,200,70,.95))}}
  .snack-slot.fx-urare img{animation:floatY 2s ease-in-out infinite}   /* ごく小さく上下に浮く（2秒周期・3px） */
  @keyframes floatY{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}
  .snack-slot.fx-urare::after{content:"";position:absolute;inset:-7%;border-radius:24%;z-index:-1;opacity:.7;
    background:conic-gradient(from 0deg,rgba(255,150,170,.5),rgba(255,220,130,.5),rgba(160,235,160,.5),rgba(140,200,255,.5),rgba(210,160,255,.5),rgba(255,150,170,.5));
    filter:blur(7px);animation:hueFlow 4s linear infinite}   /* 虹色にゆっくり流れる光（パネル画像自体は無加工） */
  @keyframes hueFlow{to{filter:blur(7px) hue-rotate(360deg)}}
  .snack-slot.swap-out img{animation:swapOut .14s ease-in forwards}   /* 入れ替え：ふわっと縮んで薄く */
  .snack-slot.swap-in  img{animation:swapIn .19s cubic-bezier(.34,1.56,.64,1) backwards}   /* ぽんっと戻る */
  @keyframes swapOut{to{opacity:0;transform:scale(.72)}}
  @keyframes swapIn{from{opacity:0;transform:scale(.72)}}

  /* 感想セリフ中のランク演出（ステージ側） */
  #petEffectLayer .eat-rain{animation:rainFall var(--rd,2800ms) linear forwards}
  @keyframes rainFall{
    0%{opacity:0;transform:translate(-50%,0) scale(.5)}
    12%{opacity:.85}
    75%{opacity:.7}
    100%{opacity:0;transform:translate(calc(-50% + var(--sway,0px)),var(--fall,300px)) scale(1)}
  }
  #petEffectLayer .eat-rain.tint-gold{filter:sepia(1) saturate(2.2) hue-rotate(-8deg) brightness(1.03)}
  #petEffectLayer .eat-rain.tint-rainbow{animation:rainFall var(--rd,2800ms) linear forwards,rainHue 3s linear infinite}
  @keyframes rainHue{to{filter:hue-rotate(360deg)}}
  .eat-stage-fx{position:absolute;inset:0;pointer-events:none;z-index:6;opacity:0}
  .eat-stage-fx.gold{background:radial-gradient(ellipse at 50% 45%,rgba(255,216,125,.34) 0%,rgba(255,216,125,0) 78%);animation:goldFlash .62s ease-out forwards}
  @keyframes goldFlash{0%{opacity:0}28%{opacity:1}100%{opacity:0}}
  .eat-stage-fx.rainbow{background:linear-gradient(115deg,rgba(255,160,180,.13),rgba(255,222,130,.12),rgba(150,230,170,.12),rgba(150,200,255,.13),rgba(215,170,255,.12),rgba(255,160,180,.13));
    background-size:280% 280%;animation:rainbowFlow 5.1s linear forwards}   /* 感想セリフの間だけ、うっすら虹色に流れる */
  @keyframes rainbowFlow{0%{opacity:0;background-position:0% 50%}14%{opacity:1}82%{opacity:1}100%{opacity:0;background-position:100% 50%}}
  .cute-action-button{
    appearance:none;border:0;background:transparent;padding:0;cursor:pointer;
    width:min(220px,44%);transition:transform .1s,opacity .25s ease}   /* opacityはおひるねボタン表示切替のフェード用 */
  #cLateNight{position:relative}
  #cLateNight .late-night-base{display:block;width:100%}
  .cute-action-button.nap-gone{opacity:0;visibility:hidden;pointer-events:none;transition:transform .1s,opacity .25s ease,visibility 0s linear .25s}   /* おひるねできない間はボタンを表示しない（レイアウトは保持し、隣のボタンが動かないようにする） */
  .bgm-image-button.nap-gone{opacity:0;visibility:hidden;pointer-events:none;transition:opacity .25s ease,visibility 0s linear .25s}   /* つまみぐい中の おやつずかん 用（cute-action-button と同じ消え方） */
  .action-row2.onedari-only #cBreath{display:none}   /* おねだり中は しんこきゅう のスペースごと畳んで おやつ を中央へ */
  .action-row2.onedari-only #cSnack{display:none}   /* おねだり中は通常サイズの おやつ は隠し、専用の大きいボタンに切り替える（同じボタンを拡縮しない） */
  #cSnackBig{width:min(310px,72vw);max-width:72vw}   /* おねだり専用の大きい おやつボタン：現れた時からこの大きさで固定（拡大アニメーションはしない） */
  #cSnackBig:not([hidden]){animation:onedariFadeIn .25s ease}   /* 出る時は不透明度だけの静かなフェード。他のボタンの消え方と同じ0.25秒（拡縮・移動は一切しない） */
  @keyframes onedariFadeIn{from{opacity:0}to{opacity:1}}
  .action-row.onedari-collapse{display:none}   /* おねだり中は上段（なでなで・おひるね）をスペースごと畳み、大きな おやつ をその高さに出す（スマホで下にはみ出さないように） */
  .cute-action-button img{display:block;width:100%;height:auto;pointer-events:none}
  .cute-action-button:active{transform:scale(.97)}
  .cute-action-button:focus-visible{outline:2px solid var(--ink);outline-offset:2px;border-radius:18px}

  /* ── あそびかた前面オーバーレイ ─────────── */
  .foot{
