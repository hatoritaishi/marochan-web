    restore:function(now){var s=ensure(now).active;return s&&s.phase==='sleep'&&s.start<=now?s:null;},
    paused:function(now){var s=ensure(now).active;return !!(s&&s.phase==='pause');},
    resume:function(now,force){var p=ensure(now),s=p.active;
      if(!s||s.phase!=='pause'||(!force&&now<s.resumeAt))return null;
      s.phase='sleep';s.start=now;s.end=now+s.targetMs-s.sleptMs;s.deep=now+30000;
