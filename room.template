  function flushHanaBubbles(){while(maroHanaBubblePending.length){var hit=maroHanaBubblePending[0],result=store.popHanaBubble(hit.id,hit.at);if(!result.saved)break;maroHanaBubblePending.shift();}}
  function outsideHanaPortrait(x,y,foreground){
    var banner=bubbleOverlay.getBoundingClientRect();if(bubble.classList.contains('on')&&x>=banner.left&&x<=banner.right&&y>=banner.top&&y<=banner.bottom)return false;
    if(foreground)return true;
    // Use the registered portrait's alpha, including ears, rather than a body box.
    if(!hanaMask)return false;
    if(restIsVisible()||['event','returning'].includes(charwrap.dataset.renderer)){
      return !!(maroMotion&&maroMotion.portraitHitTest)&&!maroMotion.portraitHitTest(x,y,6);
    }
    var r=imgBase.getBoundingClientRect();if(!r.width||!r.height)return false;
    for(var dx of [-6,0,6])for(var dy of [-6,0,6]){
      var u=(x+dx-r.left)/r.width,v=(y+dy-r.top)/r.height;
      if(u<0||u>=1||v<0||v>=1)continue;
      if(hanaMask[(Math.floor(v*560)*512+Math.floor(u*512))*4+3]>24)return false;
    }
    var b=bubbleOverlay.getBoundingClientRect();return !(bubble.classList.contains('on')&&x>=b.left&&x<=b.right&&y>=b.top&&y<=b.bottom);
  }
  maroHana.setHitFilter(outsideHanaPortrait);
  function consumeHanaTap(event){event.preventDefault();event.stopImmediatePropagation();}
  function popHanaHit(hit,event){
    if(!maroHana.pop(hit.id))return false;
    consumeHanaTap(event);hanaLastPop=hit;lastUserAction=Date.now();reserveMaroAutoEventGap(Date.now());
    maroHanaBubblePending.push({id:'hana-'+hanaSession+'-'+hit.id,at:Date.now()});flushHanaBubbles();return true;
  }
  beginMaroHanaBubbleTap=function(event){
    if(event.isPrimary===false)return false;hanaGesture=null;
    if(event.button!==0||!stage.contains(event.target)||!hanaReady())return false;
    var hit=maroHana.hit(event.clientX,event.clientY);
    if(!hit||!popHanaHit(hit,event))return false;
    // Own the complete press even if the bubble drifts, disappears or Maro changes pose.
    hanaGesture={pointer:event.pointerId,until:Infinity};return true;
  };
  ['pointerup','pointercancel'].forEach(function(type){window.addEventListener(type,function(event){
    if(hanaGesture&&hanaGesture.pointer===event.pointerId){hanaGesture.until=Date.now()+1500;consumeHanaTap(event);}
  },true);});
  stage.addEventListener('click',function(event){
    if(hanaGesture&&Date.now()<=hanaGesture.until){hanaGesture=null;consumeHanaTap(event);return;}
    if(!hanaReady())return;
    var hit=maroHana.hit(event.clientX,event.clientY);
    if(!hit){if(hanaLastPop&&Math.hypot(event.clientX-hanaLastPop.x,event.clientY-hanaLastPop.y)<=Math.max(22,hanaLastPop.radius))consumeHanaTap(event);return;}
    popHanaHit(hit,event);
  },true);
  dialog.querySelector('.outing-movie-close').addEventListener('click',function(){dismissMaroMovie();});
  lowerClose.addEventListener('click',function(){dismissMaroMovie();});
  dialog.addEventListener('cancel',function(event){event.preventDefault();dismissMaroMovie();});
  retry.addEventListener('click',function(){
    if(!maroAndroidActive||document.hidden||maroMoviePageHidden)return;
    var entry=maroOutingMovie.state().current;
    if(entry&&!maroOutingMovie.selectCurrent(entry.id))return;
    if(viewingEntry)viewingEntry.manual=true;
    if(retryPlayback){retryPlayback();return;}
    if(entry)attempt(viewingEntry||entry,maroOutingMovie.clip(entry));
  });
  window.addEventListener('pagehide',function(){onMaroDailyMovieForeground(false);maroMoviePageHidden=true;maroMomijiMovie.clear();maroOutingMovie.suspend();});
  window.addEventListener('pageshow',function(){maroMoviePageHidden=false;maroOutingMovie.tick();});
  var halloweenNextSync=0;
  window.setInterval(function(){movieProgress.tick();if(maroMovieSoundtrack)maroMovieSoundtrack.sync();if(maroAndroidActive&&!document.hidden){
    maroBedtimeMovie.tick();maroNightLetterMovie.tick();flushMaroDanceMeal();flushHanaBubbles();maroBirthdayMovie.tick();maroDailyMovies.tick();
    if(performance.now()>=halloweenNextSync){halloweenNextSync=performance.now()+1000;window.MaroHalloween.reconcile(maroOutingMovie,store,maroFeelings.current(Date.now()).halloweenCookieCount);}
    if(maroMovieRememberId&&maroOutingMovie.encounter(maroMovieRememberId))maroMovieRememberId=null;
  }observeMaroMomijiMovie();maroOutingMovie.tick();},100);
})();
/* OUTING_MOVIE_ROOM_END */
  window.maroRoomSyncHooks={
    canChange:function(){
      if(eatActive||stealActive||S.eatMunch||S.eatGlow||napTransitioning||maroMoviePlaying())return 'いまの動きが終わってから、もういちど試してください。';
      if(chatBusy())return 'おしゃべりをとじてから、もういちど試してください。';
      return '';
    },
    // Save before the mode changes: stop() must not replace a pending native
    // checkpoint with the older room life after pause() has persisted it.
    snapshot:function(){saveMaroRoomEvent();return syncMaroPetSleep(true);},
    stop:function(){
      clearTimeout(maroPetSyncTimer);maroPetSyncTimer=null;clearTimeout(maroPetStealTimer);maroPetStealTimer=null;
      clearTimeout(maroRoomLocalRestoreTimer);maroRoomLocalRestoreTimer=null;napWakePrepareSerial++;
      // Native callbacks can still request a foreground update on the next page;
      // entry guards use the persisted mode before any handoff is admitted.
    }
  };
  if(!lateNightActive(Date.now())){
  if (inNenneAutoWindow() && canStartNap()) startNap(true, nenneNext8am(), false, true);
  }
  seatedRestTick(true);
  document.documentElement.classList.remove('nenne-boot');   // 一瞬起床防止の仮非表示を解除（ねんね開始時は寝た姿への切替が済んだ後。昼間は最初から付いていない）

// Included inside the existing room scope only in the PC package.
if (window.MaroPC) {
  const canMiniTravel = () => !napTransitioning && !isMaroWaking() && !chatBusy() &&
    !maroSoundOpen && !snackOpen && !snackDexOpen && !snackBoxOpen && !eatActive && !stealActive &&
    !maroCalm.breathing && !maroCalm.quiet && !maroOutingBlocked() && !oneFootBlocked() &&
    !(typeof maroMovieBlocksAuto === 'function' && maroMovieBlocksAuto()) &&
    !(maroDailyLettersUI && maroDailyLettersUI.isOpen());
  window.MaroPCRoom = Object.freeze({
    sleeping: () => !!napActive,
    miniActivity: () => {
      const now = Date.now();
      const feelings = maroFeelings.current(now, true);
      const mode = napActive ? 3 : isMaroSeatedSleepy() || isMaroEveningDrowsy() ? 2 : isMaroResting() ? 1 : 0;
      const handoff = ['pre', 'show', 'preattack', 'hesitate', 'ask'].includes(stealPhase);
      const caught = !!stealCaughtReaction && performance.now() < stealCaughtUntil;
      const steal = !stealActive ? 0 : stealPhase === 'eat' ? 2 :
        stealPhase === 'after' && S.eatGlow ? 3 : caught ? 4 : handoff ? 1 : 0;
      const rescue = maroOneFootEvent?.state() && maroOneFootEvent;
      return {
        mode, blanket: napBlanketType || 'normal', deep: napPhase === 'deep', sleepAt: napStartedAt,
        jumpChance: moodPetJumpChance(), hungry: feelings.canOffer && now >= snackStealCooldownUntil(),
        memory: !!feelings.lastSnack, steal, caught: stealCaughtReaction?.key || 'surprise',
        sparkle: stealKey === 'sparkle' || !!maroPetMeal?.sparkleEyes,
        rescue: rescue ? (rescue.petCanvas.style.display === 'block' ? rescue.petCanvas : rescue.canvas) : null,
      };
    },
    prepareMiniHeart: (image) => MaroSprite.prototype.prepareHeartHug(image),
    startMiniRunFall: () => maroOneFootEvent?.start('run') ?? false,
    tapMiniSteal: () => {
      if (!stealActive) return false;
      onStealMaroTap();
      return true;
    },
    miniSleepLabel: () => napActive ? 'おこす' : inNenneAutoWindow() || new Date().getHours() >= 19 ? 'ねんね' : 'おひるね',
    miniSleepToggle: () => {
      if (napActive) { wakeNap(); return; }
      const night = inNenneAutoWindow() || new Date().getHours() >= 19;
      startNap(night, night ? nenneNext8am() : 0, false, false);
    },
    gameMusicLevel: () => bgmOn ? maroBgmVolume : 0,
    canMiniTravel,
    canMiniWander: () => !napActive && !isMaroResting() && canMiniTravel(),
    pet: rememberMaroPetting,
    openSnackBox: openSnackBox,
    refreshSnackBox: refreshSnackBox,
    recordGameWin: (prize) => rememberMaroEvent('game_snack_won', {
      id: 'crystal-won:' + prize.id, snackKey: prize.snack, origin: 'game',
      outcome: 'won', at: prize.acquiredAt, acquiredAt: prize.acquiredAt,
    }),
    planCrystalMeal: (request, now) => {
      let staged = localStorage.getItem('maroFeelingsV1') || JSON.stringify(maroFeelings.current(now));
      const model = createMaroFeelings({
        getItem: () => staged,
        setItem: (_key, value) => { staged = value; },
      }, () => null);
      // Only the bowl bridge validates ownership of the earned gift.
      return model.record({ type: 'snack_eaten', id: request.id, snackKey: request.snack, at: now }, now) ? staged : null;
    },
  });
}

  if(window.maroRoomStartup)maroRoomStartup.initializedAt=performance.now();
  // Native foreground/restore must not wait for every unused animation image.
  try{if(window.MaroRoomReady&&typeof MaroRoomReady.ready==='function'&&window.maroRoomReadyToken!=null)MaroRoomReady.ready(String(window.maroRoomReadyToken));}catch(error){}

  }catch(err){
    window.maroReportLoadFailure('boot',true);
    if (window.console) console.error(err);
  }
})();
</script>
<script src="./pc-ui.js"></script>
</body>
