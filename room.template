      im.alt = '';
      im.style.width = size + 'px';
      im.style.height = size + 'px';
      sp.appendChild(im);
      layer.appendChild(sp);
      (function(el, ms){
        var rm = function(){ if (el.parentNode) el.parentNode.removeChild(el); };
        el.addEventListener('animationend', rm);   // アニメーション終了後に必ずDOMから削除
        setTimeout(rm, ms + 500);                  // 保険
      })(sp, life);
