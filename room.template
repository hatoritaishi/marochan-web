  #cNap:is([data-destination="home"],[data-destination="moon"])::after{content:'おうちへ';position:absolute;bottom:2px;right:4px;
    padding:1px 7px;border-radius:12px;background:#fff6ee;color:#75472c;font-size:12px;line-height:1.6}
