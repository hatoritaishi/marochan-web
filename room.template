  function blankSnackDexEntry(){
    return {discovered:false,firstSeenAt:null,firstEatenAt:null,lastEatenAt:null,eatCount:0,memo:'',diary:'',diaryAt:null};
  }
  function cleanSnackDexTime(value){
    value = Number(value);
