function createMaroSnackAfterglow(storage){
  var key='maroSnackAfterglowV1',state=null;
  try{state=JSON.parse(storage.getItem(key)||'null');}catch(e){}
  function save(){try{storage.setItem(key,JSON.stringify(state));}catch(e){}}
  function current(now){
    if(!state||!Object.prototype.hasOwnProperty.call(SNACK_AFTERGLOW_LINES,state.snack)||!Number.isFinite(state.at)||
       now<state.at||now-state.at>=600000||!Number.isInteger(state.spoken)||state.spoken<0||state.spoken>3||!Number.isFinite(state.next)){
      if(state){state=null;save();}return null;
    }return state;
  }
  return {current:current,eaten:function(snack,now,scene){if(!Object.prototype.hasOwnProperty.call(SNACK_AFTERGLOW_LINES,snack))return;
    state={snack:snack,at:now,next:now+35000,spoken:0,last:-1,scene:['home','flowers','moon','momiji','hana','christmas'].indexOf(scene)!==-1?scene:'unknown'};save();},
    requestAllowed:function(now,random){var s=current(now);return !s||(now-s.at>=180000&&random()<.25);},
    line:function(now,random){var s=current(now);if(!s||now<s.next||s.spoken>=3)return null;
      var pool=SNACK_AFTERGLOW_LINES[s.snack],choices=pool.map(function(_,i){return i;}).filter(function(i){return i!==s.last;});
      s.last=choices[Math.min(choices.length-1,Math.floor(random()*choices.length))];s.spoken++;s.next=now+45000+Math.floor(random()*30000);save();return pool[s.last];}
  };
}
