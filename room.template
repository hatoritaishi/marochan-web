<script>
// This recovery UI must exist before dependent scripts and outside the hidden room.
(function(){
  window.maroRoomStartup={initializedAt:null,firstVisibleAt:null};
  try{window.maroRoomReadyToken=window.MaroRoomReady&&MaroRoomReady.token();}catch(error){}
  var failures=new Set(),box=null;
  window.maroReportLoadFailure=function(key,failed){
    if(failed)failures.add(key);else failures.delete(key);
    if(!failures.size){if(box)box.remove();box=null;return;}
    if(box||!document.body)return;
    box=document.createElement('div');box.id='maroLoadRecovery';box.setAttribute('role','alert');
    box.style.cssText='position:fixed;z-index:2147483000;left:16px;right:16px;top:22%;max-width:420px;margin:auto;padding:22px;background:#fffaf2;color:#70514d;border:2px solid #dabda5;border-radius:22px;box-shadow:0 6px 28px #39232033;text-align:center;font:16px/1.8 sans-serif';
    var message=document.createElement('p');message.textContent='読み込みでつまずきました。もういちど試してください。';box.appendChild(message);
    var button=document.createElement('button');button.type='button';button.textContent='もういちど';
    button.style.cssText='font:inherit;padding:10px 24px;border:1px solid #d8afb0;border-radius:14px;background:#fff;color:#765050';
    button.addEventListener('click',function(){location.reload();});box.appendChild(button);document.body.appendChild(box);
    if(window.MaroRoomSync){var detached=document.createElement('button');detached.type='button';detached.textContent='おへやの復旧';detached.style.cssText=button.style.cssText+';margin:12px 0 0';detached.addEventListener('click',function(){if(window.maroOpenRoomRecovery)window.maroOpenRoomRecovery();});box.appendChild(detached);}
  };
  window.maroKeepImageLoaded=function(image){
    var delay=1000,timer=null,key=image;
    function loaded(){clearTimeout(timer);timer=null;delay=1000;window.maroReportLoadFailure(key,false);}
    function failed(){
      window.maroReportLoadFailure(key,true);if(timer!==null)return;
      timer=setTimeout(function(){timer=null;var src=image.getAttribute('src');if(src)image.src=src;},delay);
      delay=Math.min(30000,delay*2);
    }
    image.addEventListener('load',loaded);image.addEventListener('error',failed);
    if(image.complete&&image.getAttribute('src')){if(image.naturalWidth)loaded();else failed();}
    return image;
  };
  window.maroLoadImage=function(src){return new Promise(function(resolve){
    var image=window.maroKeepImageLoaded(new Image());image.addEventListener('load',function(){resolve(image);},{once:true});image.src=src;
  });};
  window.maroRoomSyncEnabled=function(){
    if(window.MaroRoomSync)return window.MaroRoomSync.enabled();
    try{return !(JSON.parse(localStorage.getItem('maroRoomSyncV1')||'null')||{}).paused;}catch(error){return false;}
  };
})();
</script>
