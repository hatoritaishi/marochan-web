}

// Conservative repair for observed debris after a complete Japanese sentence.
// Never strip arbitrary final kanji, punctuation, emoji, or ordinary word endings.
function cleanMaroReplyText(value, userContext, currentMessage){
  var text=String(value||'').trim(),context=String(userContext||'');
  if(maroReplyTextIssue(text,currentMessage===undefined?context:currentMessage))throw new Error('invalid reply content');
  if(!/[\u3040-\u30ff\u3400-\u9fff]/u.test(text))return text;
  if(/文字|もじ|漢字|かんじ|英語|えいご|英字|アルファベット|あるふぁべっと|ローマ字|単位|翻訳|訳して|スペル|綴り|記号|そのまま|引用|コード|alphabet|spell|translate|verbatim|code/i.test(context))return text;
  var match=text.match(/^([\s\S]*[。！？])([ \t\u3000]+(?:m|en)|[ \t\u3000]*涯)$/u);
