// Shared with the Worker. Detect a narrow response-planning signature, not English
// in general. Quoted/code text and a verbatim phrase supplied by the user survive.
function maroReplyTextIssue(value, userContext){
  var normalize=function(s){return String(s||'').normalize('NFKC').replace(/\s+/gu,' ').trim().toLowerCase();};
  var context=normalize(userContext);
  var spoken=String(value||'').normalize('NFKC').replace(/```[\s\S]*?```|「[^」]*」|『[^』]*』|“[^”]*”|"[^"\n]*"/gu,' ');
