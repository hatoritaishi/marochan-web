      spriteBegUntil=Date.now()+(speech.holdMs||2600);
      spriteBegDirection='right';
    }
    if(VOICE_MAP[speech.text]==='sad'&&!snackRequestActive()&&!eatActive&&!stealActive){spriteSadUntil=Date.now()+(speech.holdMs||2600);}

    syncMaroSpeechMotion(speech);
    bubble.dataset.pawGreeting=maroSpeechMotion.kind==='paw-greeting'?maroSpeechMotion.action:'';
    bubble.dataset.pawWave=maroSpeechMotion.kind==='paw-wave'?'true':'';
    bubble.dataset.heartHug=maroSpeechMotion.kind==='heart-hug'?'true':'';
    bubble.dataset.gameProud=maroSpeechMotion.kind==='game-proud'?'true':'';
    bubble.dataset.openArms=maroSpeechMotion.kind==='open-arms'?'true':'';
    bubble.dataset.handsBackTilt=maroSpeechMotion.kind==='hands-back-tilt'?'true':'';
    bubble.dataset.screenTap=maroSpeechMotion.kind==='screen-tap'?maroSpeechMotion.action:'';
    bubble.dataset.lookBack=maroSpeechMotion.kind==='look-back'?'true':'';
    chooseStandingSpeech(speech);
    bubble.textContent=maroFlowerSpeech(speech,maroSpeechMotion);
    fitBubbleText();
    void bubble.offsetHeight;
    bubble.style.transition='';bubble.style.opacity='';
    // Optional gestures must not postpone regular speech or snack requests.
    if(maroSpeechMotion.kind!=='paw-wave'&&maroSpeechMotion.kind!=='heart-hug'){
      lastSaid=speech.text;lastTalk=Date.now();
    }
    if(sleeping)napSpeechUntil=lastTalk+Math.max(NAP_SPEECH_MIN_GAP,speech.holdMs||2600);
    bubble.classList.add('on');
    reserveMaroAutoEventGap(Date.now()+(speech.holdMs||2600));
    if(speech.chat){playPendingChatVoice();}   // AI返信：1返信につき鳴き声は最大1回
    else{playVoiceFor(speech.text);}   // セリフの表示にあわせて鳴き声を1回鳴らす
    clearTimeout(bubbleTimer);
    bubbleTimer=setTimeout(function(){bubble.classList.remove('on');clearMaroHeartHugSpeech();},speech.holdMs||2600);
    if(maroSpeechMotion.kind==='heart-hug')beginMaroHeartHugSpeech(speech.text);
    if(!speech.gameProudPeak&&!speech.outingCue)blinkOnEvent(.5, 170 + Math.random()*170);   // 話し出した拍子にまばたきが引きずられて出る
    if(S.excited)startBegFx();
  }
  var uruSpeechClock={cycle:-1,pending:null,flushing:false};
  function tickUruGestureSpeech(player){
    if(maroOutingBlocked())return ;
    if(maroSoundOpen)return;
    if(!player.loaded)return;
    var beat=player.uruSpeechBeat();
    if(!beat){uruSpeechClock.cycle=-1;uruSpeechClock.pending=null;return;}
    if(beat.cycle<uruSpeechClock.cycle)uruSpeechClock.cycle=-1;
    if(!beat.starting||uruSpeechClock.cycle===beat.cycle)return;
    uruSpeechClock.cycle=beat.cycle;
    if(eatActive||napActive||napTransitioning||chatBusy()||maroCalm.breathing||maroCalm.quiet||
       (snackOpen&&(urareInSlots()||crystalSnackReward))||Date.now()-lastTalk<5000)return;
    var queued=uruSpeechClock.pending;
    if(!queued&&!(S.excited&&S.excitedKind==='uru'))return;
    if(!excitedHeld&&S.excited&&(excitedSayCount>=2||Date.now()-excitedSince>7400))return;
    uruSpeechClock.pending=null;uruSpeechClock.flushing=true;
    try{say(queued?queued.text:pickExcited(),queued?queued.holdMs:2600);}
    finally{uruSpeechClock.flushing=false;}
  }
  function say(text, holdMs, source){
    if(typeof maroMoviePlaying==='function'&&maroMoviePlaying())return;
    if(maroOutingBlocked())return;
    if(isMaroConversationSource(source)&&petTalkLocked())return;
    if(oneFootBlocked())return;
    if(maroCuriosityActive()||maroScreenTapActive())return;
    if(maroSoundOpen)return;
    if(maroCalm.breathing||chatBusy()) return;
    if(isMaroWaking()&&!snackOpen&&!eatActive&&!stealActive&&!napActive&&TAP_TALK.indexOf(text)!==-1)text=pickWakeLine(Date.now());
    var speech={text:text||(S.excited?pickExcited():pickMaroTapTalk()),holdMs:holdMs,source:source};
    // Reminders may be requested during the neutral pause. Keep one line,
    // then display it (and its voice) at the next gesture's first moving cel.
    if(!uruSpeechClock.flushing&&isWaterySnackLine(speech.text)&&!eatActive&&!S.sadTears&&
       ((S.excited&&S.excitedKind==='uru')||(stealActive&&stealPhase==='ask'&&S.stealUru))){
      uruSpeechClock.pending=speech;return;
    }
    if(!bubbleFontsReady){pendingBubbleSpeech=speech;return;}
    displayBubbleSpeech(speech);
  }

  // ── ランダム喜び顔（テンション高い表情イベント） ──
  function startExcited(){
    if(maroOutingBlocked())return ;
    if(!snackOpen&&!canStartMaroAutoEvent()){S.excitedPending=false;return;}
    if(snackOpen&&crystalSnackReward){S.excitedPending=false;return;}
    if(!maroMealAllowed()){S.excitedPending=false;return;}
    if(isMaroDrowsy()){S.excitedPending=false;return;}
    if(!snackOpen&&activityBreakDue()){S.excitedPending=false;return;}
    var satisfiedSnack=maroSnackAfterglow&&maroSnackAfterglow.current(Date.now());
    if(!snackOpen&&satisfiedSnack&&Date.now()-satisfiedSnack.at<180000){S.excitedPending=false;return;}
    if(isMaroWaking()&&!snackOpen){S.excitedPending=false;return;}
    if(isMaroResting()){S.excitedPending=false;return;}
    if(hasMaroSpeechMotion()&&maroSpeechMotion.kind!=='paw-wave'&&maroSpeechMotion.kind!=='heart-hug')return;
    if(maroSoundOpen)return;
    if(chatBusy())return;
    if(maroCalm.breathing || maroCalm.quiet) return;
    if (napActive || napTransitioning){ S.excitedPending = false; return; }   // おひるね中・出入り中は喜び顔を開始しない（ねんねの一時起床中は低確率で出る）
    if (snackDexOpen){ S.excitedPending = false; return; }   // 図鑑を開いている間はおねだりを開始しない
    // おやつバー開放中もおねだりを開始できる（待機中の時間経過抽選から来る。虹色は下のガードで一巡後のみ）
    if (snackOpen && urareInSlots() && !urareLoopRoundDone){ S.excitedPending = false; return; }   // 虹色：発見セリフが一巡してから
    if (eatActive) return;              // おやつ演出中はおねだりを開始しない
    if (stealActive){ S.excitedPending = false; return; }   // つまみぐい中は喜び顔を開始しない
    if (Date.now() < stealAteUntil){ S.excitedPending = false; return; }   // つまみぐいで食べた後3分はおねだりを開始しない（B案）
    if (S.excited || S.hold || S.happy > 0) return;   // なでなで系が最優先
    if (S.blinkT !== null) return;                    // まばたき中は開始しない
    S.excited = true; S.excitedPending = false;
    S.excitedKind = (snackOpen && urareInSlots()) ? 'genki' : (Math.random() < 0.20 ? 'uru' : 'genki');   // 虹色が並んでいる間は必ず元気おねだり（ガード1）。それ以外は50/50で抽選
    cancelAutoTalkStep2();   // 喜び顔の開始で二段目はキャンセル（割り込ませない）
    excitedSince = Date.now();
    excitedHeld = !!snackOpen; excitedSayCount = 0;   // バー開放中に始まったおねだりは、あげる・閉じるまで表情を保持（開いている限り続く）
    clearTimeout(excitedSayTimer);
    excitedSayTimer = setTimeout(excitedSay, 5000);
    clearTimeout(excitedEndTimer);
    if (!excitedHeld) excitedEndTimer = setTimeout(endExcited, EXCITED_DURATION);   // 10秒で即時復帰（フェードなし）。バー開放中の保持時は自動終了しない
    queueMaroRoomEventSave();
  }
  function excitedSay(){
      if (!S.excited) return;
      if (Date.now() - lastTalk < 5000){              // 直前にセリフが出ていたら間が詰まらないよう1.5秒後ずれ
        excitedSayTimer = setTimeout(excitedSay, 1500);
        return;
      }
      if (!excitedHeld && Date.now() - excitedSince > 8000) return;   // 終了間際に新しいセリフは出さない（表情とのズレ防止。最終の後ずれ枠）
      if (!excitedHeld && excitedSayCount >= 2) return;   // セリフは最大2回（バー開放中の保持時はあげる・閉じるまで続ける）
      say(pickExcited());                             // 開始から5秒後にセリフを出す（直前にセリフがあれば間隔をあけて後ずれ）
      excitedSayCount++;
      if (excitedHeld){                               // バー開放で保持中は7〜11秒ごとにおねだりを続ける（黙り込まないように）
        excitedSayTimer = setTimeout(excitedSay, randomInt(7000, 11000));
      }
