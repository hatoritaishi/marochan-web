function createMaroDailyMood(storage,random){
  var key='maroDailyMoodV1',state=null,types=['affectionate','relaxed','playful'];
  try{state=JSON.parse(storage.getItem(key)||'null');}catch(e){}
  return {current:function(now){
    var d=new Date(now),date=d.getFullYear()+'-'+(d.getMonth()+1)+'-'+d.getDate();
    if(!state||state.date!==date||types.indexOf(state.kind)===-1){
      state={date:date,kind:types[Math.min(2,Math.floor(random()*3))]};
      try{storage.setItem(key,JSON.stringify(state));}catch(e){}
    }return state.kind;
  }};
}
var maroDailyMood=createMaroDailyMood({getItem:function(k){return localStorage.getItem(k);},setItem:function(k,v){localStorage.setItem(k,v);}},Math.random);
function currentDailyMood(){var f=maroFeelings&&maroFeelings.current(Date.now());return f&&f.comfort>=65?'affectionate':f&&f.joy>=65?'playful':maroDailyMood.current(Date.now());}
function moodAutoTalkRate(){var m=currentDailyMood();return m==='affectionate'?.65:m==='relaxed'?.82:.75;}
function moodSnackChance(base){var m=currentDailyMood();return base*(m==='relaxed'?.9:m==='playful'?1.1:1.05)*maroSnackRequestFactor();}
function moodPetJumpChance(){var m=currentDailyMood();return m==='playful'?.14:m==='relaxed'?.08:.10;}
function moodPick(pool){
  var mood=currentDailyMood(),preferred=pool.filter(function(value){
    var lines=Array.isArray(value)?value:[value];
    return lines.some(function(t){return mood==='affectionate'?classifyMaroSpeech(t)==='uru':mood==='playful'?classifyMaroSpeech(t)==='jump':/あったか|ぼーっ|おちつ|ほっと|ぽかぽか|のんびり|ひなた|ねむ|ふぁ/.test(t);});
  });
  return pick(preferred.length&&Math.random()<.25?preferred:pool);
}

function createMaroPetContentment(storage){
  var key='maroPetContentmentV1',until=0;
  try{until=Number(storage.getItem(key))||0;}catch(e){}
  return {receive:function(now){until=now+600000;try{storage.setItem(key,String(until));}catch(e){}},
