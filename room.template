    S.eatMunch = true; S.eatMouthH = false;
    var mouthStep = 0;
    (function mouthLoop(){
      if (!S.eatMunch) return;
      mouthStep = (mouthStep + 1) % 3;
      S.eatMouthH = (mouthStep === 1);
      eatLater(mouthLoop, 333);
    })();
    if ((snack.rank || 'normal') === 'normal'){ say(pick(THANKS_LINES), 2000); }   // お礼は2秒で切り替え（もぐもぐへの移行を速く）   // ノーマルは従来の共通お礼（rank未設定のおやつもノーマル扱い）
    else {   // レア以上：50%でそのデザートの専用お礼、50%でランク共通のお礼
      var tPool = (snack.rank === 'urare') ? THANKS_URARE : THANKS_RARE;
      say(Math.random() < 0.5 ? snack.thanks : pick(tPool), 2000);   // お礼は2秒で切り替え（もぐもぐへの移行を速く）
    }
    eatLater(function(){   // 約2秒〜はもぐもぐセリフに切り替え（お礼→もぐもぐの2段表示）
      if (!eatActive || !S.eatMunch) return;
      say(pick(munchPool(snack)), 4800);
    }, 2000);

    // ── 食べ終わり：なでなで目⇔通常目のゆっくり交互ループ＋喜び口固定＋食べたセリフ ──
    eatLater(function(){
      if (!eatActive) return;
      S.eatMunch = false; S.eatMouthH = true;   // 喜び口で固定
      S.eatGlow = true;S.eatFxDraining=false;S.snackGlowAt=performance.now();
      S.eatGlowPet = Math.random() < 0.5;   // 食後の目は なでなで目/通常目 をランダムで1つ決める（途中切り替えなし。なでなで目ならロック解除までそのまま）
      var efx = EAT_RANK_FX[snack.rank] || EAT_RANK_FX.normal;   // ランクで継続エフェクトの倍率と間隔が変わる
      bounceNudge((snack.rank === 'urare') ? 0.30 : 0.25);   // ウルトラレアはいつもより高くぴょんっ
      (function fxWave(){                 // ハート＆キラキラ：ロック解除まで出続ける（倍率と間隔はランク別）
        if (!S.eatGlow || S.eatFxDraining) return;
        spawnPetEffects(efx.mult[0] + Math.random() * (efx.mult[1] - efx.mult[0]));
        eatLater(fxWave, efx.wave);
      })();
      startEatRankFx(snack.rank || 'normal');   // ランク専用の追加演出（rank未設定はノーマル扱いで演出なし）
      maroSnackAfterglow.eaten(key,Date.now(),maroDialogueScene());
      say(maroFoodMemoryLine(key), 5000);   // 食べたおやつ専用セリフ（感想は5秒じっくり表示）
      eatLater(endEat, 5000);             // 感想セリフが消えるのと同時に通常顔へ戻す（それまでとじる以外操作不可）
    }, 7000);
  }

  document.getElementById('cSnack').addEventListener('click', openSnackMode);
