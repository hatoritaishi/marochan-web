  function recordSnackEaten(key, stealCase, originalMealAt){
    if (!SNACK_POOL[key]) return;
    var now = Date.now(), entry = snackDexData[key] || blankSnackDexEntry();
    // A native meal is admitted now but keeps its original history and cooldown clock.
    var eatenAt = Number.isFinite(originalMealAt) && originalMealAt > 0 ? Math.min(originalMealAt, now) : now;
    var reward=!stealCase&&crystalSnackReward&&crystalSnackReward.snack===key?crystalSnackReward:null;
    var mealId=reward?'crystal-meal:'+reward.id:stealCase&&maroMemoryStealSerial?'steal-eaten:'+maroMemoryStealSerial:'room-meal:'+now+':'+(++maroFeelingEventSequence);
    if(!maroFeelings.tryMeal(key,mealId,now,!!stealCase,reward&&reward.id))return false;
    if(typeof beginMaroDanceMeal==='function')beginMaroDanceMeal(mealId,key);
    maroDialogueMeal={key:key,firstTaste:!(entry.eatCount>0)};
    if(reward){crystalSnackReward=null;crystalSnackConsumed=true;clearCrystalSnackChoice();refreshSnackBox();}
    // Once a meal is accepted, optional memory work must not cancel its animation.
    try{rememberMaroSnackEaten(eatenAt);}catch(error){console.warn("Maro snack cooldown record failed");}
    try{
    var event=Object.assign(memorySnackFields(key),{id:mealId,at:eatenAt,case:stealCase||'given',source:stealCase?maroMemoryStealSource:'room',caught:!!stealCase&&stealFound,permitted:!stealCase||stealCase==='foundPermitted'||stealCase==='rarePermitted'});
    if(reward){event.origin='game';event.acquiredAt=reward.acquiredAt||0;event.detail='げーむで取れたおかしを、きみがまろちゃんにあげてくれた。まろちゃんが食べた。';}
    if(stealCase&&maroMemoryStealSerial)event.id='steal-eaten:'+maroMemoryStealSerial;
    rememberMaroEvent('snack_eaten',event);
    }catch(error){console.warn("Maro snack journal record failed");}
    try{maroChatMemory.eaten(key,eatenAt,snackDexData);}catch(error){console.warn("Maro snack chat memory failed");}
    try{
    if (!entry.discovered){ entry.discovered = true; entry.firstSeenAt = eatenAt; snackDexNew[key] = true; }
    if (!entry.firstEatenAt) entry.firstEatenAt = eatenAt;
    entry.lastEatenAt = eatenAt;
    entry.eatCount = Math.max(0, Number(entry.eatCount) || 0) + 1;
    var diaryPool = stealCase ? SNACK_DEX_STEAL_DIARY[stealCase] : SNACK_DEX_DIARY[key];   // まろちゃんの日記：食べるたびに3パターンからランダムで書く（すでにあれば上書き。つまみぐいは結果別プール）
    if (diaryPool && diaryPool.length){ entry.diary = diaryPool[Math.floor(Math.random() * diaryPool.length)]; entry.diaryAt = eatenAt; }
    snackDexData[key] = entry;
    saveSnackDex();
    }catch(error){console.warn("Maro snack catalog record failed");}
    return true;
  }
