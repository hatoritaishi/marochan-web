  // ── 食べたあとの入れ替え（ふわっと縮んで→差し替え→ぽんっと戻る。合計約440ms） ──
  var rerolling = false, suppressReroll = false, pendingEatSlot = -1;   // pendingEatSlot: 入れ替え中のタップ予約
  function rerollSnackSlots(){
    if (rerolling || !snackOpen || crystalSnackReward || crystalSnackConsumed) return;
    rerolling = true;
    stopSnackFx();   // 入れ替え前のキラキラは必ず止めて削除
    var keys = rollSnackSlots(true);   // 食べ切ったあとの入れ替え：ここでだけ天井カウントを消費して抽選
    var seq = rerollSeq;
    var outMs = reduce ? 120 : 140, inMs = reduce ? 150 : 190, stag = reduce ? 0 : 55;
    for (var k = 0; k < 3; k++){
      (function(slot, key, idx){
        setTimeout(function(){
          if (seq !== rerollSeq) return;   // 途中で閉じて開き直されたら古い演出は中断
          slot.classList.add('swap-out');
          setTimeout(function(){
            if (seq !== rerollSeq){ slot.classList.remove('swap-out'); return; }
            slot.dataset.key = key;
            slot.querySelector('img').src = SNACK_POOL[key].image;
            recordSnackSeen(key);   // 図鑑：入れ替えで実表示されたおやつを記録
            slot.classList.remove('swap-out');
            slot.classList.remove('fx-rare','fx-srare','fx-ssrare','fx-urare');
            var rank = SNACK_POOL[key].rank || 'normal';
            if (rank !== 'normal') slot.classList.add('fx-' + rank);
            slot.classList.add('swap-in');
            setTimeout(function(){ slot.classList.remove('swap-in'); }, inMs);
          }, outMs);
        }, idx * stag);
      })(snackSlots[k], keys[k], k);
    }
    setTimeout(function(){
      rerolling = false;   // 入れ替えが終わったらすぐタップできる
      if (seq !== rerollSeq){ pendingEatSlot = -1; return; }
      startSnackFx();   // 新しいランクでキラキラ出直し
      startUrareFoundLoop(keys);   // 入れ替え結果に虹色がいれば発見セリフのループ開始（予約タップですぐ食べ始めた場合はeatSnack側で停止される）
      scheduleSpecialSnack();   // 入れ替え結果にレア以上（虹色以外）がいれば特別セリフの抽選を再開
      if (pendingEatSlot >= 0 && snackOpen && !eatActive){   // 入れ替え中の予約タップを、その枠の新しい中身で発動
        var ps = pendingEatSlot; pendingEatSlot = -1;
        eatSnack(snackSlots[ps].dataset.key);
      } else pendingEatSlot = -1;
    }, outMs + inMs + 2 * stag + 10);
  }

  // ── 感想セリフ中のランク演出（レア以上で強化。まろちゃんとセリフは常に見える範囲で） ──
  var EAT_RANK_FX = {
    normal: { mult:[1.0,1.5], wave:500 },   // ノーマルは現状のまま
    rare:   { mult:[1.6,2.2], wave:450 },
    srare:  { mult:[2.2,2.8], wave:400 },
    ssrare: { mult:[2.8,3.5], wave:330 },
    urare:  { mult:[3.5,4.5], wave:260 }
  };
  function spawnSideSparkles(n){   // まろちゃんの左右からキラキラがまとめて弾ける（1回きり）
    if (!fxLayer) return;
    var box = getCharBox();
    if (!box.w || !box.h) return;
    var used = {};
    for (var i = 0; i < n; i++){
      var asset = pickPetEffectAsset('sparkle', used);
      if (!asset) break;
      used[asset.id] = (used[asset.id] || 0) + 1;
      createPetParticle(asset, PET_MOTION.sparkleTwinkle, box,
                        { type:'zone', side:(i % 2) ? 'L' : 'R', zoneIndex:i % 3 }, i * 26);
    }
  }
  function spawnRainSparkle(cap, tint){   // ステージの上からキラキラがゆっくり降る（同時 cap 個まで・吹き出し手前で消える）
    if (!fxLayer) return;
    var rainNow = fxLayer.querySelectorAll('.eat-rain').length;
    if (fxLayer.childElementCount - rainNow >= FX_MAX_ALIVE) return;   // 降り注ぎ分は上限の対象外（専用枠を確保）
    if (rainNow >= cap) return;
    var sw = stage.clientWidth, sh = stage.clientHeight;
    if (!sw || !sh) return;
    var img = document.createElement('img');
    img.className = 'fx eat-rain' + (tint ? ' ' + tint : '');
    img.src = FX_SRC['sparkle' + 'ABC'[randomInt(0, 2)]];
    img.alt = '';
    var w = Math.max(14, Math.round(sw * randomRange(0.035, 0.06)));
    img.style.width = w + 'px';
    img.style.height = w + 'px';
    img.style.left = (sw * randomRange(0.06, 0.94)) + 'px';
    img.style.top = (-w) + 'px';
    img.style.setProperty('--fall', Math.round(sh * 0.68 + w) + 'px');   // 吹き出しの手前で消える高さ
    img.style.setProperty('--sway', randomRange(-18, 18).toFixed(0) + 'px');
    img.style.setProperty('--rd', randomInt(2400, 3200) + 'ms');
    fxLayer.appendChild(img);
    var rm = function(){ if (img.parentNode) img.parentNode.removeChild(img); };
    img.addEventListener('animationend', rm);
    setTimeout(rm, 3800);
    return img;
  }
  function addStageFx(kind){
    var ov = document.createElement('div');
    ov.className = 'eat-stage-fx ' + kind;
    stage.appendChild(ov);
    if (kind === 'gold') ov.addEventListener('animationend', function(){ if (ov.parentNode) ov.parentNode.removeChild(ov); });
    return ov;
  }
  function stopEatRankFx(){   // 強化演出の後始末（生成タイマーはclearEatTimers側で停止）
    S.eatFxDraining = false;
    var ovs = stage.querySelectorAll('.eat-stage-fx');
    for (var i = 0; i < ovs.length; i++) ovs[i].parentNode.removeChild(ovs[i]);
    var rains = fxLayer ? fxLayer.querySelectorAll('.eat-rain, .eat-particle') : [];
    for (var j = 0; j < rains.length; j++) rains[j].parentNode.removeChild(rains[j]);
  }
  function startEatRankFx(rank){
    if (S.eatFxDraining) return;
    if (rank === 'normal') return;
    spawnSideSparkles(randomInt(8, 12));   // レア以上共通：左右からキラキラが弾ける
    if (rank === 'rare') return;
    if (!reduce){   // スーパーレア以上：上からキラキラが降り注ぐ（reduce時は降らせない）
      var cap  = (rank === 'srare') ? 8 : (rank === 'ssrare' ? 12 : 16);
      var tint = (rank === 'ssrare') ? 'tint-gold' : ((rank === 'urare') ? 'tint-rainbow' : '');
      var rainMs = Math.round(2800 / cap);   // 寿命約2.8秒なので cap ÷ 2.8秒 の間隔で降らせて常時 cap 個程度に保つ
      (function rain(){
        if (!S.eatGlow || S.eatFxDraining) return;
        spawnRainSparkle(cap, tint);
        eatLater(rain, rainMs);
      })();
    }
    if (rank === 'ssrare') addStageFx('gold');      // ステージ全体が一瞬だけ淡い金色に光る
    if (rank === 'urare')  addStageFx('rainbow');   // 感想セリフの間うっすら虹色に流れる
  }

  function openSnackMode(options){
    syncHalloweenSnackPanels();
    if(maroOutingBlocked())return ;
    if(maroScreenTapActive())return;
    if(snackDisappointedActive())return;
    // A normal button click always offers the saved lineup; only BOX selection offers a prize.
    var ordinary=!(options&&options.crystal===true);
    if(snackBoxOpen)return;
    if(ordinary&&!maroFeelings.current(Date.now(),true).canOffer){if(!eatActive&&!napActive&&!napTransitioning&&!chatBusy())declineMaroSatisfiedOffer();return;}
    if(!ordinary&&!chooseCrystalSnack(crystalSnackChoice))return;
    if(isMaroDrowsy()||isMaroWaking()){say(pick(REST_SLEEPY_SNACK_LINES),3500);return;}
    if(maroSoundOpen)return;
    if (napActive || napTransitioning) return;   // おひるね中はおやつバーを開かない（新規食事・おねだりも始めない）
    if (snackDexOpen || snackBoxOpen) return;   // 図鑑を開いている間はおやつバーを開かない
    if (snackOpen) return;
    if (stealActive) return;              // つまみぐい中は通常バーを開かない
    if(!standForSnack(!ordinary))return;   // Prize snacks pause an awake rest; ordinary snacks finish it.
    barIdleSulkUntil = 0;                 // おやつを出してもらえたら、しゅんは解除
    snackOpen = true;
    resetSnackBarUru();
    S.snackShownAt=performance.now();
    if (S.excited){   // おねだり中にバーを開いたら終了タイマーを保留（あげる・閉じるまで表情を保持）
      clearTimeout(excitedEndTimer);
      excitedHeld = true;
      if (S.excitedKind === 'uru' && urareInSlots()) S.excitedKind = 'genki';   // うるうるおねだり中に虹色が並んだら元気おねだりに切替（うるうるのまま継続させない・ガード3）
    }
    cancelAutoTalkStep2();   // バーを開いたら二段目はキャンセル
    pendingEatSlot = -1;   // 保険：開き直しでは予約タップを持ち越さない
    if (prepareCrystalSnackSlots(ordinary)){
      // The prize is displayed in all three slots until a meal is accepted.
    } else if (snackSlots.every(function(slot){return !!SNACK_POOL[slot.dataset.key];}) && !crystalSnackReward){
      refreshSnackSlotFx();   // 開いて閉じただけでは並びは変えない（ズル防止）。キラキラだけ再開
      resumeUrareFoundLoop();   // まだ食べられていない虹色が残っていれば、同じ3個の発見セリフループを再開
    } else {
      var savedKeys = loadSnackPanels();
      var shownKeys = savedKeys || rollSnackSlots(false);   // 初回だけ補充（回数消費なし）。保存済みの並びがあれば復元
      applySnackSlots(shownKeys);
      startUrareFoundLoop(shownKeys);   // 新しく表示された並びに虹色がいれば発見セリフのループ開始
    }
    beginSnackBarRequest();
    closeMaroChat(false);
    snackRows[0].hidden = true; snackRows[1].hidden = true;
    snackBar.hidden = false;
    snackCloseBtn.style.display = '';   // 保険: 開いたときは必ず表示
    scheduleSpecialSnack();   // レア以上（虹色以外）が並んでいれば「特別なおかし」セリフの抽選を開始
    if (!urareInSlots()&&!crystalSnackReward){   // Discovery/game prize dialogue owns speech while these panels are shown.
      if (Date.now() - lastSnackOpenSayAt >= SNACK_OPEN_SAY_INTERVAL){   // 開く・とじるを連打してもセリフは5秒に1回まで（置き換わらない）
        lastSnackOpenSayAt = Date.now();
        if (S.excited) say(pick(S.excitedKind === 'uru' ? SNACK_OPEN_URU : SNACK_OPEN_GENKI));   // おねだり中はその顔に合わせる（顔とセリフを一致させる）
        else say(pick(SNACK_OPEN));   // 通常顔のまま開いた時
      }
    }
  }
  function waitForEatEffects(done, later){
    if (!S.eatGlow) return false;
    if (!S.eatFxDraining){
      S.eatFxDraining = true;
      // The looping stage glow ends with the comment. Emitted particles finish
      // their own animations before the smile, meal lock and snack bar end.
      var overlays = stage.querySelectorAll('.eat-stage-fx');
      for (var i = 0; i < overlays.length; i++) overlays[i].remove();
    }
    if (fxLayer && fxLayer.querySelector('.eat-particle, .eat-rain')){
      later(done, 50);
      return true;
    }
    return false;
  }
  function endEat(force){
    if (!eatActive) return;
    if (force !== true && waitForEatEffects(endEat, eatLater)) return;
    if(force!==true&&!S.eatMunch&&S.eatGlow)finishMaroDanceMeal();else cancelMaroDanceMeal();
    eatActive = false;
    refreshSnackBox();
    lockSnackPetting(3000);
    snackBar.classList.remove('eating');   // 通常顔に戻ったらパネルを押せる見た目に戻す
    snackCloseBtn.disabled = false;
    snackCloseBtn.style.display = '';     // 通常顔に戻ったら「とじる」再表示・再有効化
    clearEatTimers();
    stopEatRankFx();                      // ランク強化演出の光・降り注ぎを消してDOM削除
    S.eatMunch = false; S.eatGlow = false; S.eatFxDraining = false; S.eatGlowPet = false; S.eatMouthH = false;
    S.hold = false;
    excitedCooldownUntil = Date.now() + EXCITED_COOLDOWN;   // 食後すぐおねだりが再発動しないようクールダウン
    scheduleBlink();
    if ((snackOpen && !suppressReroll) || crystalSnackConsumed){
      if(crystalSnackConsumed)restoreCrystalSnackSlots();   // 景品は一時表示。食べても元の3枠・天井カウントを変えない。
      else applySnackSlots(rollSnackSlots(true));   // 通常のおやつを食べ終わった時だけ次の3枠を抽選する。
      crystalSnackConsumed=false;
      closeSnackMode();   // 無言で閉じる：放置クローズの「しゅん…」セリフは言わない（eatActive解除済みなので内側のendEat再呼び出しは即returnし再入しない）
    }
  }
  function closeSnackMode(){
    if (!snackOpen) return;
    suppressReroll = true;                // とじる中断では入れ替えない
    pendingEatSlot = -1;                  // 閉じたら予約タップも破棄
    stopUrareFoundTimers();               // 閉じたら発見セリフループは止める（開き直したとき再開される）
    endEat(true);                         // 食べ中・ロック中にとじる場合は演出を即中断して通常状態へ
    suppressReroll = false;
    stopSnackFx();                        // 閉じたらパネルのキラキラ停止＋DOM削除
    clearTimeout(specialSnackTimer); specialSnackTimer = null;   // 閉じたら特別セリフの抽選も停止
    snackOpen = false;
    resetSnackBarUru();
    if (excitedHeld && S.excited){   // 保留していたおねだりはバーを閉じて3秒後に終了
      excitedHeld = false;
      clearTimeout(excitedEndTimer);
      excitedEndTimer = setTimeout(endExcited, 3000);
    }
