  }
  function normalizeSnackDexEntry(value){
    var clean = blankSnackDexEntry();
    if (!value || typeof value !== 'object') return clean;
    clean.discovered = value.discovered === true;
    clean.firstSeenAt = cleanSnackDexTime(value.firstSeenAt);
    clean.firstEatenAt = cleanSnackDexTime(value.firstEatenAt);
    clean.lastEatenAt = cleanSnackDexTime(value.lastEatenAt);
    clean.eatCount = Math.max(0, Math.floor(Number(value.eatCount) || 0));
    clean.memo = typeof value.memo === 'string' ? value.memo.slice(0, 500) : '';
    clean.diary = typeof value.diary === 'string' ? value.diary.slice(0, 200) : '';
    clean.diaryAt = cleanSnackDexTime(value.diaryAt);
    if (clean.eatCount > 0 || clean.firstEatenAt || clean.lastEatenAt) clean.discovered = true;
    return clean;
  }
