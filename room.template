  function eatSnack(key){
    // A queued movie waits for the open snack bar; it must not discard its tap.
    // A playing movie still owns input and cannot accept a meal underneath it.
    if(maroOutingMovie&&maroOutingMovie.playing())return;
    if(isMaroEveningDrowsy()){declineSeatedSnack();return;}
    if (eatActive || rerolling || !SNACK_POOL[key]) return;   // モグモグ〜食後5秒と入れ替え中は連打・多重発動を無効
    // Recheck before consuming a prize; sleep/drowsiness keeps it in the native queue.
    if(napActive||napTransitioning||isMaroDrowsy()||isMaroWaking()){closeSnackMode();return;}
    if(!standForSnack(!!crystalSnackReward)){closeSnackMode();return;}
    eatActive=true;
    if(!recordSnackEaten(key)){eatActive=false;handleMaroMealFailure();return;}   // 図鑑：実際に食べた時だけ「たべた」を記録
    pendingEatSlot = -1;   // 手動タップで食べ始めたら古い予約は捨てる（二重発動防止）
    stopUrareFoundTimers();   // パネルを押して食べ始めたら発見セリフループは終了
    clearTimeout(specialSnackTimer); specialSnackTimer = null;   // 食事中は特別セリフを出さない
    cancelAutoTalkStep2();   // 食べ始めたら二段目はキャンセル
    eatActive = true;
    resetSnackBarUru();
    snackBar.classList.add('eating');   // 食べている間はパネルを薄くして押せない見た目に
    snackCloseBtn.disabled = true;
    snackCloseBtn.style.display = 'none';   // 食べ開始〜ロック解除までは「とじる」を表示しない
    stopSnackFx();                        // 食べ始めたらパネルのキラキラは止める（まろちゃんの演出に視線を集める）
    var snack = SNACK_POOL[key];
    S.snackFeeling=snackFeeling(snack.rank);
    endExcited();                         // おねだり中にあげたらおねだり解除
    excitedCooldownUntil = Date.now() + EXCITED_COOLDOWN;
