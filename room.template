<style>
  :root{
    --cream:#FFF6F0; --peach:#FFE0D1; --sand:#FFD9C2;
    --sora:#BDE6FF; --sakura:#FFC2D1; --sumi:#2A2A2A;
    --ink:#6B5B54; --line:rgba(107,91,84,.14);
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{
    font-family:"Zen Maru Gothic","Hiragino Maru Gothic ProN","M PLUS Rounded 1c",sans-serif;
    background:linear-gradient(180deg,#FFFAF6 0%,#FFF1E8 100%);
    color:var(--sumi); -webkit-font-smoothing:antialiased;
    padding:12px 12px 20px; min-height:100vh;
  }
  .wrap{max-width:640px;margin:0 auto}

  /* ── ヘッダー ─────────────────────────── */
  header{display:flex;align-items:flex-start;gap:10px;margin-bottom:8px}
  .title-img{display:block;width:min(250px,52vw);max-width:100%;height:auto;flex:0 1 auto;min-width:0}

  /* ── 右上トグル（BGM） ─────────────────── */
  .toggles{flex:0 0 auto;display:flex;gap:12px;align-items:flex-start}
  .tgl{display:flex;flex-direction:column;align-items:center;gap:4px;
    background:none;border:none;font-family:inherit;cursor:pointer;padding:2px}
  .tgl .cap{font-size:10.5px;color:var(--ink);font-weight:500;white-space:nowrap;line-height:1}
  .tgl .sw{width:44px;height:24px;border-radius:999px;background:#F4F0EC;
    border:1px solid var(--line);position:relative;transition:background .2s}
  .tgl .sw::after{content:'';position:absolute;top:2px;left:2px;width:18px;height:18px;
    border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(60,40,30,.22);transition:left .18s}
  .tgl.on .sw::after{left:22px}
  #tBgm.on  .sw{background:#FFD9E2}   /* ON：淡いピンク */
  .tgl:focus-visible{outline:2px solid var(--ink);outline-offset:2px;border-radius:8px}
  @media (max-width:420px){
    .toggles{gap:8px}
    .tgl .cap{font-size:9.5px}
    .tgl .sw{width:38px;height:21px}
    .tgl .sw::after{width:15px;height:15px}
    .tgl.on .sw::after{left:19px}
    header{gap:8px}
  }

  /* ── 右上トグル（BGM画像ボタン） ─────────────── */
  .bgm-image-button{
    appearance:none;border:0;background:transparent;padding:0;cursor:pointer;
    flex:0 0 auto;line-height:0;transition:transform .1s}
  .bgm-image-button img{display:block;width:110px;height:auto;pointer-events:none}
  .bgm-image-button:active{transform:scale(.97)}
  .bgm-image-button:focus-visible{outline:2px solid var(--ink);outline-offset:2px;border-radius:12px}
  @media (max-width:420px){
    .bgm-image-button img{width:96px}
  }

  /* ── ステージ（部屋） ──────────────────── */
  .stage{
    position:relative;width:100%;height:460px;height:clamp(203px, calc(100dvh - 423px), 460px);border-radius:22px;overflow:hidden;
    background:#F6ECE4;cursor:pointer;user-select:none;-webkit-user-select:none;
    box-shadow:0 2px 0 rgba(107,91,84,.08);
  }
  .room{position:absolute;inset:0;filter:blur(3px)}
  .roomimg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 42%}   /* 新しい背景イラスト（ぼかしなし・添付画像そのまま） */
  .wall{position:absolute;inset:0 0 32% 0;
    background:linear-gradient(170deg,#FBF3ED 0%,#F6E9E0 100%)}
  .floor{position:absolute;left:0;right:0;bottom:0;height:34%;
    background:linear-gradient(180deg,#E9D5C3 0%,#DCC3AD 100%)}
  .floor::after{content:'';position:absolute;inset:0;opacity:.35;
    background:repeating-linear-gradient(96deg,rgba(255,255,255,.5) 0 2px,transparent 2px 26px)}
  .rug{position:absolute;left:50%;bottom:2%;width:74%;height:20%;transform:translateX(-50%);
    border-radius:50%;background:radial-gradient(ellipse at 50% 40%,#FFFBF7 0%,#F6EAE0 70%,#EFDDD0 100%)}
  .window{position:absolute;right:-4%;top:4%;width:34%;height:52%;border-radius:10px;
    background:linear-gradient(200deg,rgba(255,255,255,.95),rgba(240,250,255,.6));
    box-shadow:0 0 70px 40px rgba(255,255,255,.55)}
  .lamp{position:absolute;left:14%;top:40%;width:56px;height:56px;border-radius:50%;
    background:radial-gradient(circle,#FFE9B8 0%,rgba(255,224,160,.55) 45%,transparent 70%)}
  .shelf{position:absolute;left:2%;top:47%;width:26%;height:22%;border-radius:6px;
    background:linear-gradient(180deg,#E6C9A8,#D9B693)}
  .frame{position:absolute;left:12%;top:12%;width:14%;height:17%;border-radius:5px;
    background:#FBF1EA;border:5px solid #EBD9CC;display:flex;align-items:center;justify-content:center}
  .frame span{color:var(--sakura);font-size:17px}
  .pillow{position:absolute;right:6%;bottom:26%;width:24%;height:12%;border-radius:16px;
    background:linear-gradient(160deg,#FBD9DE,#F3C3CC)}
  .vine{position:absolute;right:16%;top:-2%;width:2px;height:34%;background:#BFD3A8}
  .leaf{position:absolute;width:16px;height:9px;border-radius:0 100% 0 100%;background:#C6DBAE}
  .plant{position:absolute;left:5%;top:32%;width:44px;height:34px;
    background:radial-gradient(circle at 50% 100%,#C6DBAE 0%,#B6CE9B 60%,transparent 62%)}

  .stagefx{position:absolute;inset:0;pointer-events:none;
    background:radial-gradient(ellipse at 50% 42%,transparent 45%,rgba(180,150,130,.13) 100%)}

  /* ── キャラクター ─────────────────────── */
  .creature{position:absolute;left:50%;bottom:5%;transform-origin:50% 100%;will-change:transform;z-index:4}
  .charwrap{position:relative;transform-origin:50% 100%;will-change:transform}
  .charwrap img{position:absolute;display:block;pointer-events:none;user-select:none;-webkit-user-select:none}
  .charwrap{transition:opacity .5s ease}   /* おひるね出入りのクロスフェード用（通常時はopacity:1のまま・従来挙動と同じ） */
  .nap-pos{position:absolute;left:50%;bottom:0;width:1086px;transform:translateX(-50%) translateY(6.06%);opacity:0;pointer-events:none;transition:opacity .5s ease}   /* 睡眠画像6枚の共通コンテナ：bottom-center基準。外側は位置補正専用（雲の下端を立ち姿の足元に揃える） */
  .nap-breath{position:relative;width:100%;aspect-ratio:1/1;transform-origin:50% 100%;will-change:transform}   /* 内側は呼吸scale専用。位置補正と呼吸を別DOMに分けてtransform競合を防ぐ */
  .nap-breath img{position:absolute;left:0;top:0;width:100%;height:100%;object-fit:contain;opacity:0;transition:opacity .5s ease;pointer-events:none;user-select:none;-webkit-user-select:none;transform:translateY(-4.9%) scale(1.2356)}   /* 縦横比維持・引き伸ばしなし */
  .shadow{position:absolute;left:50%;bottom:4%;width:150px;height:20px;margin-left:-75px;
    border-radius:50%;background:rgba(150,115,95,.20);filter:blur(6px)}

  /* ── セリフ吹き出し（ステージ内オーバーレイ：画像＋動的テキスト。文字は焼き込まない） ── */
  .bubble-overlay{
    position:absolute;left:50%;bottom:10px;transform:translateX(-50%);
    width:min(455px, calc(100% - 16px));
    display:flex;justify-content:center;
    pointer-events:none;z-index:3;             /* 背景より前、まろちゃん・なでなでエフェクトより後ろ */
  }
  .bubble{
    position:relative;
    width:100%;
    aspect-ratio:940/172;                       /* 吹き出し本文背景（css-bubble-bg.webp）の実寸比。縦横を歪ませない */
    display:flex;align-items:center;justify-content:center;
    text-align:center;box-sizing:border-box;
    /* 新バナーは帯が画像の真ん中に来るため、縦paddingは付けずflex中央揃えだけで帯のど真ん中に乗る。横は両端の飾りを避ける12% */
    padding:0 12%;
    background:url("media/460c8d49c63c7140a0e6465e.webp") center/100% 100% no-repeat;
    color:#744A3A;
    font-family:"Kiwi Maru","Zen Maru Gothic","M PLUS Rounded 1c","Hiragino Maru Gothic ProN",sans-serif;
    font-size:18.5px;font-weight:500;letter-spacing:.01em;line-height:1;
    white-space:nowrap;
    opacity:0;transform:translateY(7px) scale(1);
    transition:opacity .34s ease,transform .34s cubic-bezier(.22,.61,.36,1);
  }
  .bubble.on{opacity:1;transform:translateY(0) scale(1)}

  /* ── なでなでエフェクト専用レイヤー ───────── */
  #petEffectLayer{
    position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:5;
  }
  #petEffectLayer .fx{
    position:absolute;display:block;pointer-events:none;
    user-select:none;-webkit-user-select:none;
    opacity:0;will-change:transform,opacity;
    transform:translate(-50%,-50%) rotate(var(--rot,0deg));
  }
