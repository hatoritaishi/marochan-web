  function maroFlowerSpeech(speech,motion){
    // Sway copy describes the actual posture, including while out on a trip.
    if(speech.source==='pet'&&MARO_PET_SWAY_LINES.indexOf(speech.text)!==-1)return speech.text;
    if(!maroOuting||['flowers','momiji','hana','christmas'].indexOf(maroOuting.state().scene)===-1||speech.chat||speech.outingCue)return speech.text;
    var family=maroFlowerPools&&maroFlowerPools[speech.text];
    if(family==='memory'){var remembered=maroSnackAfterglow.current(Date.now());if(!remembered||remembered.scene!==maroOuting.state().scene)family='memory-away';}
    if(speech.source==='greeting'&&window.MaroDialogueRules.greetingOnly.indexOf(speech.text)!==-1)return speech.text;
    if(!family||family==='normal'||family==='snack-beg'){
      if(napActive)family='sleep-talk';
      else if(S.eatMunch)family='eating';
      else if(S.eatGlow)family='meal-after';
      else if(S.hold||S.happy>0)family='pet';
      else if(S.sadTears||barIdleSulking())family='snack-disappointed';
      else if(S.excited)family=S.excitedKind==='uru'?'drool-beg':'snack-excited';
      else if(maroCalm.breathing)family='breathing';
      else if(isSleepySpeech(speech.text))family=Date.now()<spriteYawnUntil?'yawn':'sleepy';
      else if(motion&&Date.now()<motion.until){
        family={'curiosity':'thinking','snack-memory':'memory','uru':'pet-beg'}[motion.kind]||motion.kind;
        if(motion.kind==='screen-tap')family=motion.action==='sparkle'?'screen-tap-sparkle':'screen-tap-closed';
        if(motion.kind==='paw-greeting')family=motion.action==='open'?'greeting-open':'greeting';
      }
    }
    return window.MaroOuting.sceneLine(maroOuting.state().scene,family||'normal',speech.text,Math.random,roomPeriodAt(new Date()));
  }
