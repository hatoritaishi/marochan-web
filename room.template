  function endExcited(){                              // 継続・瞬き・終了予約をすべてキャンセル
    barIdleSulkUntil = 0;   // 断られ「しゅん」の印も必ず一緒に畳む（タイマーのズレで おねだりレイアウトが一瞬復活しないように）
    S.sadTears = false;   // うるうる顔の終了と一緒に涙も必ずしまう（放置クローズの涙用。おねだり経由では常にfalse）
    if (!S.excited && !S.excitedPending) return;
    S.excited = false; S.excitedPending = false;
    excitedHeld = false;
    clearTimeout(excitedEndTimer);
    clearTimeout(excitedSayTimer);
    excitedCooldownUntil = Date.now() + EXCITED_COOLDOWN;
    queueMaroRoomEventSave();
