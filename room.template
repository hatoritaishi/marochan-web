.snack-box-top p{font-size:11px;margin:0 0 3px}.snack-box-top h2{font-size:23px;line-height:1.3;margin:0;letter-spacing:.06em}
.snack-box-top button,.snack-box-bottom button{font:700 14px/1.5 'Zen Maru Gothic',sans-serif;min-height:44px;border:1px solid #d8afb0;border-radius:16px;background:#fff;color:#765050;padding:9px 15px;cursor:pointer}
.snack-box-info{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:13px 18px 0;font-size:14px}.snack-box-info span{font-size:11px;color:#92766a}
.snack-box-status{font-size:12px;line-height:1.7;padding:0 18px;margin:10px 0 14px;min-height:40px}
.snack-box-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding:0 18px 18px}
.snack-box-card{position:relative;display:flex;flex-direction:column;align-items:center;min-width:0;border:1px solid #e8c8b6;border-radius:19px;background:#fff;padding:10px 8px 12px;color:#74524d;box-shadow:0 4px 0 #efdfd2;font-family:inherit;cursor:pointer}
.snack-box-card img{display:block;width:min(100%,150px);aspect-ratio:1;object-fit:contain}.snack-box-card strong{font-size:12px;line-height:1.5;text-wrap:balance;margin-top:5px}.snack-box-quantity{position:absolute;right:7px;top:7px;border-radius:12px;background:#fff8e9;border:1px solid #e5c9a5;padding:3px 8px;font-size:14px;font-weight:700;font-variant-numeric:tabular-nums}
.snack-box-rank{font-size:10px;margin:4px 0 8px}.snack-box-action{font-size:11px;border-radius:12px;padding:6px 8px;background:#f7ebe7;width:100%}
.snack-box-card.rank-rare{background:#f5fcff;border-color:#a8d2e6}.snack-box-card.rank-srare{background:#fbf6ff;border-color:#cab1dd}.snack-box-card.rank-ssrare{background:linear-gradient(140deg,#fff,#fff2ca);border-color:#dcc07d}.snack-box-card.rank-urare{background:linear-gradient(135deg,#fff0f4,#fffce0,#e9faff,#f7eeff);border-color:#d5add2}
.snack-box-card:active{transform:translateY(2px);box-shadow:0 2px 0 #efdfd2}.snack-box-dialog button:focus-visible,#cSnackBox:focus-visible{outline:3px solid #74b6ce;outline-offset:3px}
.snack-box-dialog button:disabled,#cSnackBox:disabled{opacity:.5;cursor:default}.snack-box-empty{text-align:center;padding:25px 18px 35px;font-size:14px}.snack-box-empty[hidden]{display:none}.snack-box-empty p{font-size:13px;line-height:1.8;margin-bottom:0}
.snack-box-bottom{padding:15px 18px 18px;border-top:1px dashed #ddc5b5;text-align:center}.snack-box-bottom button{width:100%;background:#fff4e6}.snack-box-bottom p{font-size:11px;line-height:1.7;margin:10px 0 0;color:#947367}
@media(min-width:520px){.snack-box-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
