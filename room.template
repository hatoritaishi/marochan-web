  function tryStartExcited(){
    var selected=arguments[0]===true;
    if(!canStartMaroAutoEvent()){S.excitedPending=false;return;}
    if(snackDisappointedActive()){S.excitedPending=false;return;}
    if(snackOpen&&crystalSnackReward){S.excitedPending=false;return;}
    if(!maroMealAllowed()){S.excitedPending=false;return;}
    if(isMaroDrowsy()){S.excitedPending=false;return;}
    if(!snackOpen&&activityBreakDue()){S.excitedPending=false;return;}
    if(!selected&&!snackOpen&&maroSnackAfterglow&&!maroSnackAfterglow.requestAllowed(Date.now(),Math.random)){S.excitedPending=false;return;}
    if(isMaroWaking()&&!snackOpen){S.excitedPending=false;return;}
    if(isMaroResting()){S.excitedPending=false;return;}
    if(hasMaroSpeechMotion()&&maroSpeechMotion.kind!=='paw-wave'&&maroSpeechMotion.kind!=='heart-hug')return;
    if(maroSoundOpen)return;
    if(snackOpen)return; // Bar moods use the 14s/8s deferred clock below.
    if(chatBusy())return;
    if(maroCalm.breathing || maroCalm.quiet) return;
    if (napActive || napTransitioning) return;   // おひるね中・出入り中は喜び顔抽選を止める
    if (snackDexOpen || snackBoxOpen) return;   // 図鑑を開いている間はおねだり抽選を止める
    // おやつバー開放中も時間経過でおねだり抽選する（開いた瞬間の抽選とは別に、待機中の抽選として動く）
    if (snackOpen && urareInSlots() && !urareLoopRoundDone) return;   // 虹色：発見セリフが一巡してから抽選開始
    if (eatActive) return;              // おやつ演出中はおねだり抽選を止める
    if (stealActive) return;              // つまみぐい中は喜び顔の抽選自体を止める
    if (Date.now() < stealAteUntil) return;   // つまみぐいで食べた後3分はおねだり抽選を止める（B案）
    if (S.excited || S.excitedPending || S.hold || S.happy > 0) return;
    if (Date.now() < excitedCooldownUntil) return;
    if (!selected&&Math.random() >= (napIsNenne ? NENNE_EXCITED_CHANCE*maroSnackRequestFactor() : moodSnackChance(EXCITED_CHANCE))) return;   // 通常時は共通抽選、ねんねの一時起床中は従来の低確率
    if (S.blinkT !== null){ S.excitedPending = true; return; }   // 当選時がまばたき中なら終了を待つ
    startExcited();
