  // ── 素材（画像）の定義 ─────────────────────────
  var PET_FX = [
    { id:'heartA',      kind:'heart',     ratio:0.740, base:0.135, weight:11, each:2, op:0.96 },
    { id:'heartB',      kind:'heart',     ratio:0.696, base:0.140, weight:10, each:2, op:0.94 },
    { id:'heartC',      kind:'heart',     ratio:0.495, base:0.118, weight:12, each:2, op:0.96 },
    { id:'sparkleA',    kind:'sparkle',   ratio:0.632, base:0.115, weight:11, each:2, op:1.00 },
    { id:'sparkleB',    kind:'sparkle',   ratio:0.621, base:0.115, weight:10, each:2, op:1.00 },
    { id:'sparkleC',    kind:'sparkle',   ratio:0.446, base:0.098, weight:11, each:2, op:1.00 },
    { id:'bubbleSmall', kind:'bubble',    ratio:0.227, base:0.125, weight:10, each:2, op:0.92 },
    { id:'paw',         kind:'paw',       ratio:0.787, base:0.150, weight:10, each:3, op:0.95 },
    { id:'bubbleLarge', kind:'bubbleBig', ratio:0.850, base:0.170, weight:10, each:1, op:0.62 }
  ];
  for (var fxi = 0; fxi < PET_FX.length; fxi++) PET_FX[fxi].src = FX_SRC[PET_FX[fxi].id];

  // ── 軌道（動き）の定義 ─────────────────────────
  var PET_MOTION = {
    heartSway:      { anim:'fxHeartSway',      sway:true,  ax:[0.030,0.060], ay:[0.16,0.25], dur:[ 760,1080], scale:[0.85,1.15], rot:22 },
    heartStraight:  { anim:'fxHeartStraight',  sway:false, ax:[0.004,0.026], ay:[0.17,0.27], dur:[ 760,1100], scale:[0.85,1.15], rot:20 },
    heartBurst:     { anim:'fxHeartBurst',     sway:false, burst:true,       dur:[ 820,1150], scale:[0.58,0.88], rot:18 },
    sparkleTwinkle: { anim:'fxSparkleTwinkle', sway:false, axPx:[-2,2], ayPx:[-6,-1], dur:[ 620, 940], scale:[0.80,1.15], rot:60 },
    pawStraight:    { anim:'fxPawStraight',    sway:false, axPx:[-4,4], ay:[0.10,0.17], dur:[ 820,1120], scale:[0.85,1.08], rot:16 },
    bubbleSway:     { anim:'fxBubbleSway',     sway:true,  ax:[0.038,0.072], ay:[0.16,0.26], dur:[ 800,1150], scale:[0.80,1.10], rot:16 },
    bubbleBigSway:  { anim:'fxBubbleSway',     sway:true,  ax:[0.030,0.055], ay:[0.13,0.21], dur:[ 900,1250], scale:[0.85,1.08], rot:12 },
    napBubble:      { anim:'fxBubbleSway',     sway:true,  ax:[0.018,0.042], ay:[0.12,0.20], dur:[2400,3300], scale:[0.72,1.00], rot:10 },
    napBubbleBig:   { anim:'fxBubbleSway',     sway:true,  ax:[0.015,0.034], ay:[0.10,0.17], dur:[2800,3700], scale:[0.78,1.02], rot:8 }
  };
  var PET_KIND_MOTION = { sparkle:'sparkleTwinkle', paw:'pawStraight',
                          bubble:'bubbleSway', bubbleBig:'bubbleBigSway' };

  var FX_ZONES = {
    L: [ { u:[-0.22, 0.01], v:[0.08, 0.30] },   // 左耳の外側
         { u:[-0.20, 0.02], v:[0.30, 0.50] },   // 左ほっぺの外側
         { u:[-0.18, 0.06], v:[0.52, 0.80] } ], // 左肩〜身体の左
    R: [ { u:[ 0.99, 1.22], v:[0.08, 0.30] },   // 右耳の外側
         { u:[ 0.98, 1.20], v:[0.30, 0.50] },   // 右ほっぺの外側
         { u:[ 0.94, 1.18], v:[0.52, 0.80] } ], // 右肩〜身体の右
    T: [ { u:[ 0.15, 0.85], v:[-0.02, 0.055] } ] // 頭の少し上
  };
  var FX_ZONES_BIG = {
    L: [ { u:[-0.28,-0.06], v:[0.26, 0.62] } ],
    R: [ { u:[ 1.06, 1.28], v:[0.26, 0.62] } ]
  };
  FX_ZONES.NAP = [ { u:[0.18, 0.60], v:[0.24, 0.31] } ];       // おひるね専用：寝顔の頭の少し上からシャボン玉を出す（既存ゾーンは変更しない追加キー）
  FX_ZONES_BIG.NAP = [ { u:[0.12, 0.64], v:[0.20, 0.29] } ];   // 同上（大きめシャボン玉用）
  var FX_FACE = { u:0.50, v:0.42 };   // 花火の始点＝顔の中央付近

  var fxLayer = document.getElementById('petEffectLayer');
  var FX_MAX_ALIVE = 96;   // 既に出たエフェクトを途中削除せず完走させつつ、過負荷時だけ新規生成を抑える

  function randomRange(min, max){ return min + Math.random() * (max - min); }
  function randomInt(min, max){ return Math.floor(randomRange(min, max + 1)); }
  function randomPick(a){ return a[randomInt(0, a.length - 1)]; }
  function shuffle(a){
    for (var i = a.length - 1; i > 0; i--){
      var j = randomInt(0, i), t = a[i]; a[i] = a[j]; a[j] = t;
    }
    return a;
  }

  function getCharBox(){
    var sr = stage.getBoundingClientRect();
    var cr = charwrap.getBoundingClientRect();
    return {
      x: cr.left - sr.left, y: cr.top - sr.top,
      w: cr.width, h: cr.height,
      sw: sr.width, sh: sr.height
    };
  }

  function pickPetEffectAsset(kind, used){
    var pool = [], total = 0, i, a;
    for (i = 0; i < PET_FX.length; i++){
      a = PET_FX[i];
      if (a.kind !== kind) continue;
      if ((used[a.id] || 0) >= a.each) continue;
      pool.push(a); total += a.weight;
    }
    if (!pool.length){        // 上限に達していたら制限なしで選び直す
      for (i = 0; i < PET_FX.length; i++){
        if (PET_FX[i].kind === kind){ pool.push(PET_FX[i]); total += PET_FX[i].weight; }
      }
    }
    if (!pool.length) return null;
    var r = Math.random() * total;
    for (i = 0; i < pool.length; i++){
      r -= pool[i].weight;
      if (r <= 0) return pool[i];
    }
    return pool[pool.length - 1];
  }

  function createPetParticle(asset, motion, box, place, delay){
    if(oneFootBlocked())return false;
    // 既に表示されたハート等はanimationendまで残す。上限時は「新規」だけ見送る。
    if (fxLayer.childElementCount >= FX_MAX_ALIVE) return false;
    var img = document.createElement('img');
    img.className = 'fx' + (S.eatGlow ? ' eat-particle' : '');
    img.src = asset.src;
    img.alt = '';

    var sc        = randomRange(motion.scale[0], motion.scale[1]);
    var contentPx = box.w * asset.base * sc;   // 実際に見える絵の大きさ
    var boxPx     = contentPx / asset.ratio;   // 透明余白を含めたimgの大きさ
    img.style.width  = boxPx + 'px';
    img.style.height = boxPx + 'px';

    var pad = contentPx * 0.60;
    var x, y, ax, ay;

    if (place.type === 'burst'){
      x = box.x + box.w * FX_FACE.u + randomRange(-0.03, 0.03) * box.w;
      y = box.y + box.h * FX_FACE.v + randomRange(-0.02, 0.02) * box.h;
      var rad = place.angle * Math.PI / 180;
      var ux = Math.cos(rad), uy = -Math.sin(rad);   // 画面座標なのでYは反転
      var r  = box.w * randomRange(0.42, 0.60);
      if (ux > 0.001)  r = Math.min(r, (box.sw - pad - x) / ux);
      if (ux < -0.001) r = Math.min(r, (pad - x) / ux);
      if (uy > 0.001)  r = Math.min(r, (box.sh - pad - y) / uy);
      if (uy < -0.001) r = Math.min(r, (pad - y) / uy);
      r  = Math.max(r, box.w * 0.20);
      ax = ux * r; ay = uy * r;
    } else {
      var zones = (asset.kind === 'bubbleBig') ? FX_ZONES_BIG[place.side] : FX_ZONES[place.side];
      var z = zones[place.zoneIndex % zones.length];
      x = box.x + randomRange(z.u[0], z.u[1]) * box.w;
      y = box.y + randomRange(z.v[0], z.v[1]) * box.h;
      var outward = (place.side === 'T') ? (Math.random() < 0.5 ? -1 : 1) : (x < box.sw / 2 ? -1 : 1);
      ax = motion.axPx ? randomRange(motion.axPx[0], motion.axPx[1])
                       : outward * box.w * randomRange(motion.ax[0], motion.ax[1]);
      if (motion.sway && Math.random() < 0.5) ax = -ax;   // 揺れ始める向きは左右ランダム
      ay = motion.ayPx ? randomRange(motion.ayPx[0], motion.ayPx[1])
                       : -box.h * randomRange(motion.ay[0], motion.ay[1]);
    }

    var dur  = Math.round(randomRange(motion.dur[0], motion.dur[1]));
    var anim = motion.anim;

    if (reduce){
      if (!motion.sway){ x += ax; y += ay; }
      ax = 0; ay = 0;
      anim = 'fxReduced'; dur = 460; delay = Math.min(delay, 70);
    }

    var xMin = motion.sway ? -Math.abs(ax) : Math.min(0, ax);
    var xMax = motion.sway ?  Math.abs(ax) : Math.max(0, ax);
    var yMin = Math.min(0, ay), yMax = Math.max(0, ay);
    var loX = pad - xMin, hiX = box.sw - pad - xMax;
    var loY = pad - yMin, hiY = box.sh - pad - yMax;
    x = (loX <= hiX) ? Math.max(loX, Math.min(hiX, x)) : box.sw / 2;
    y = (loY <= hiY) ? Math.max(loY, Math.min(hiY, y)) : box.sh / 2;
    img.style.left = x.toFixed(1) + 'px';
    img.style.top  = y.toFixed(1) + 'px';

    img.style.setProperty('--ax',  ax.toFixed(1) + 'px');
    img.style.setProperty('--ay',  ay.toFixed(1) + 'px');
    img.style.setProperty('--rot', randomRange(-motion.rot, motion.rot).toFixed(1) + 'deg');
    img.style.setProperty('--op',  String(asset.op));
    img.style.animation = anim + ' ' + dur + 'ms linear ' + delay + 'ms forwards';

    var gone = false;
    function removeSelf(){
      if (gone) return;
      gone = true;
      clearTimeout(img._fxT);
      if (img.parentNode) img.parentNode.removeChild(img);
    }
    img.addEventListener('animationend', removeSelf);
    img._fxT = setTimeout(removeSelf, delay + dur + 500);

    fxLayer.appendChild(img);
    return true;
  }

  // 左右の割り振り：左3〜5・右3〜5を必ず確保し、個数差は最大1。中央上は0〜2個まで
  function buildPetSides(n, allowTop){
    var nT = allowTop ? Math.min(randomInt(0, 2), Math.max(0, n - 6)) : 0;
    var rest = n - nT;
    var nL = Math.floor(rest / 2), nR = rest - nL;
    if (nL !== nR && Math.random() < 0.5){ var tmp = nL; nL = nR; nR = tmp; }
    var arr = [];
    var turn = Math.random() < 0.5 ? 'L' : 'R';   // 交互に並べて左右を自然に散らす
    while (nL > 0 || nR > 0){
      if (turn === 'L' && nL > 0){ arr.push('L'); nL--; turn = 'R'; }
      else if (turn === 'R' && nR > 0){ arr.push('R'); nR--; turn = 'L'; }
      else if (nL > 0){ arr.push('L'); nL--; }
      else { arr.push('R'); nR--; }
    }
    for (var i = 0; i < nT; i++) arr.splice(randomInt(0, arr.length), 0, 'T');
    return arr;
  }

  function buildBurstAngles(k){
    var nL = Math.round(k * 0.4);
    var nT = Math.max(1, k - 2 * nL);
    var nR = k - nL - nT;
    function spread(cnt, lo, hi){
      var out = [], span = (hi - lo) / cnt;
      for (var i = 0; i < cnt; i++) out.push(lo + span * i + randomRange(span * 0.15, span * 0.85));
      return out;
    }
    var angles = spread(nL, 106, 154).concat(spread(nT, 74, 106), spread(nR, 26, 74));
    return shuffle(angles);
  }

  function spawnZoned(list, box, used, startDelay){
    if (!list.length) return 0;
    var allowTop = (box.y + box.h * 0.045) > 14;
    var sides = buildPetSides(list.length, allowTop);
    var zoneTurn = { L: randomInt(0, 2), R: randomInt(0, 2) };
    // 中央上(T)に非キラキラ素材が当たった分は左右へ振り替える。最終的な左右差が1以内に
    // 収まるよう、振替先は個数を確定させてからシャッフルして割り当てる
    var targetL = 0, targetR = 0, conv = 0, i;
    for (i = 0; i < sides.length; i++){
      if (sides[i] === 'L') targetL++;
      else if (sides[i] === 'R') targetR++;
      else if (list[i].kind !== 'sparkle') conv++;
    }
    var convL = Math.max(0, Math.min(conv, Math.round((targetR - targetL + conv) / 2)));
    var convSides = [];
    for (i = 0; i < convL; i++) convSides.push('L');
    for (i = convL; i < conv; i++) convSides.push('R');
    shuffle(convSides);
    var delay = startDelay || 0, made = 0;
    for (i = 0; i < list.length; i++){
      var item = list[i], side = sides[i];
      if (side === 'T' && item.kind !== 'sparkle') side = convSides.pop();
      var zi = 0;
      if (side !== 'T'){ zi = zoneTurn[side]; zoneTurn[side] = (zoneTurn[side] + 1) % 3; }
      var asset = pickPetEffectAsset(item.kind, used);
      if (!asset) continue;
      used[asset.id] = (used[asset.id] || 0) + 1;
      createPetParticle(asset, PET_MOTION[item.motion], box,
                      { type:'zone', side:side, zoneIndex:zi }, Math.round(delay));
      made++;
      delay = Math.min(delay + randomRange(15, 30), 180);   // 花火とほぼ同時にぽぽぽっと出す
    }
    return made;
  }

  // ── 周囲エフェクトの構成：合計6〜10個（ハート・キラキラ・肉球を主役に、シャボン玉はアクセント）──
  function buildPetPlan(){
    var plan = {
      heart:     randomInt(2, 3),
      sparkle:   randomInt(2, 3),
      paw:       randomPick([1, 1, 2, 2, 3]),           // 肉球は1〜3個で毎回存在感を出す
      bubble:    randomPick([0, 1, 1]),
      bubbleBig: (Math.random() < 0.10) ? 1 : 0          // 大シャボン玉は低確率
    };
    var total = plan.heart + plan.sparkle + plan.paw + plan.bubble + plan.bubbleBig;
    while (total < 6){                                   // 左右あわせて最低6個を保証
      if (plan.heart <= plan.sparkle) plan.heart++; else plan.sparkle++;
      total++;
    }
    while (total > 10){                                  // 上限10個（肉球→ハート→キラキラの順で調整）
      if (plan.paw > 1) plan.paw--;
      else if (plan.heart > 2) plan.heart--;
      else plan.sparkle--;
      total--;
    }
    return plan;
  }

  function spawnPetEffects(mult){
    mult = mult || 1;                     // おやつ食後は1〜1.5倍の乱数を渡す（通常のなでなでは1倍で不変）
    if (!fxLayer) return;
    var box = getCharBox();
    if (!box.w || !box.h) return;

    var used = {}, i;

    // ── ハート花火：毎回必ず1セット（10〜15個）を顔の中心から上半円へ弾けさせる（現状仕様を維持）──
    var k = Math.max(1, Math.round(randomInt(10, 15) * mult));
    var angles = buildBurstAngles(k);

    // ── 左右エフェクト：花火とは別枠で、左3〜5個・右3〜5個を毎回必ず出す ──
    var plan = buildPetPlan();
    for (var pk in plan){ plan[pk] = Math.max(0, Math.round(plan[pk] * mult)); }   // 波ごとに量を1〜1.5倍でランダム化
    var list = [];
    for (i = 0; i < plan.heart; i++){
      list.push({ kind:'heart', motion:(Math.random() < 0.533) ? 'heartSway' : 'heartStraight' });
    }
    for (i = 0; i < plan.sparkle; i++)   list.push({ kind:'sparkle',   motion:PET_KIND_MOTION.sparkle });
    for (i = 0; i < plan.bubble; i++)    list.push({ kind:'bubble',    motion:PET_KIND_MOTION.bubble });
    for (i = 0; i < plan.paw; i++)       list.push({ kind:'paw',       motion:PET_KIND_MOTION.paw });
    for (i = 0; i < plan.bubbleBig; i++) list.push({ kind:'bubbleBig', motion:PET_KIND_MOTION.bubbleBig });
    shuffle(list);

    // ── 連打対策：既存エフェクトは途中削除しない。安全上限時のみ新規生成側で抑制する ──

    for (i = 0; i < k; i++){
      var ha = pickPetEffectAsset('heart', used);
      if (!ha) break;
      used[ha.id] = (used[ha.id] || 0) + 1;
      createPetParticle(ha, PET_MOTION.heartBurst, box,
                        { type:'burst', angle:angles[i] }, randomInt(0, 40));
    }
    spawnZoned(list, box, used, randomInt(0, 30));
  }

  // ── おねだり中の周囲エフェクト：セリフのバブル表示中（2600ms）だけ、顔の中心の花火ではなく体の周り（左右・頭上ゾーン）に出す ──
  var begFxUntil = 0, begFxRunning = false;
  function spawnBegEffects(){
    if (!fxLayer) return;
    var box = getCharBox();
    if (!box.w || !box.h) return;
    var used = {}, i;
    var plan = buildPetPlan();   // 構成はなでなでと同じ（6〜10個/波）。ハート花火burstは出さない
    var list = [];
    for (i = 0; i < plan.heart; i++){
      list.push({ kind:'heart', motion:(Math.random() < 0.533) ? 'heartSway' : 'heartStraight' });
    }
    for (i = 0; i < plan.sparkle; i++)   list.push({ kind:'sparkle',   motion:PET_KIND_MOTION.sparkle });
    for (i = 0; i < plan.bubble; i++)    list.push({ kind:'bubble',    motion:PET_KIND_MOTION.bubble });
    for (i = 0; i < plan.paw; i++)       list.push({ kind:'paw',       motion:PET_KIND_MOTION.paw });
    for (i = 0; i < plan.bubbleBig; i++) list.push({ kind:'bubbleBig', motion:PET_KIND_MOTION.bubbleBig });
    shuffle(list);
    spawnZoned(list, box, used, randomInt(0, 30));
  }
  function startBegFx(){
    begFxUntil = Date.now() + 2600;        // セリフのバブル表示時間と同じ
    if (begFxRunning) return;              // 連続でセリフが出ても波ループは1本だけ（期間だけ延長）
    begFxRunning = true;
    (function wave(){
      if (!S.excited || Date.now() > begFxUntil){ begFxRunning = false; return; }   // なでなで・おやつでおねだり終了なら即停止
      spawnBegEffects();
      setTimeout(wave, 500);
    })();
  }

  // なでなで：ほっとする弾みが基本。うれしい時だけ、間を置いてもう一度。
  var petHopTimers = [];
  function clearPetHops(){ for (var i = 0; i < petHopTimers.length; i++) clearTimeout(petHopTimers[i]); petHopTimers.length = 0; }
  function bounceNudge(v){ if(reduce||isMaroResting())return; S.bounceK = 110; S.bounceC = 19; S.bounceV = -Math.min(v,2.8); }   // なでなで以外の軽い「ぴょこん」は従来どおり一定
  function doPetHop(){
    clearPetHops();S.bounce=0;S.bounceV=0;
    // The complete-pose player decides occasional jumps on a new happy event.
  }

  function snackRequestActive(){
    return snackOpen||stealActive||((S.excited||S.excitedPending)&&!barIdleSulking());
  }
  function snackPetLocked(){
    if(Date.now()<uiReturnHoldUntil||eatActive||S.eatMunch||S.eatGlow||S.sadTears||barIdleSulking())return true;
    var mode=charwrap.dataset.motionMode||'';
    return ['waiting','a2-return','drool-return','chin-return','sparkle-return','review','caught','steal-approved','munch','meal-ready','jumping','satisfied','settling','snack-disappointed','snack-disappointed-return','failed','failed-return','uru-return'].indexOf(mode)!==-1;
  }
  function lockSnackPetting(ms){
    uiReturnHoldUntil=Math.max(uiReturnHoldUntil,Date.now()+ms);
    clearTimeout(petTimer);petTimer=null;clearTimeout(petBeatTimer);petBeatTimer=null;
    S.hold=false;S.happy=0;lastPet=0;
  }
  function petAnimationLocked(){
    // Head strokes must not retire the event before pet() checks its priority.
    // A sleepy reply queued by petting still lets repeated strokes extend that pet.
    return maroOutingBlocked()||oneFootBlocked()||snackRequestActive()||snackPetLocked()||hasMaroSpeechMotion()||maroCalm.breathing||maroCalm.quiet||snackDexOpen||snackBoxOpen||
      (!S.hold&&S.happy<=0&&isMaroDrowsy())||Date.now()<spriteSadUntil||Date.now()<spritePuuUntil;
  }
  function isMaroConversationSource(source){return source==='tap-talk'||source==='auto-talk'||source==='rest-auto-talk';}
  function petTalkLocked(){
    var mode=charwrap.dataset.motionMode||'';
    return S.hold||S.happy>0||Date.now()<maroRestPetUntil||
      mode==='petted'||mode==='pet-return'||mode==='pet-sway-return'||mode==='pet-jump-return'||
      (bubble.classList.contains('on')&&bubble.dataset.petSpeech==='true')||
      !!(pendingBubbleSpeech&&(pendingBubbleSpeech.source==='pet'||pendingBubbleSpeech.source==='rest-pet'));
  }
  function chooseMaroPetSwayCycles(){
    var config=MARO_SPRITES['pet-sway'].sway;
    return config.minCycles+Math.floor(Math.random()*(config.maxCycles-config.minCycles+1));
  }
  function maroPetSwayDuration(cycles){
    var config=MARO_SPRITES['pet-sway'].sway;
    var duration=function(seq){return seq.reduce(function(sum,step){return sum+step[1];},0);};
    return duration(config.intro)+duration(config.loop)*cycles+duration(config.outro);
  }
  function pet(){
    if(typeof maroMovieBlocksAuto==='function'&&maroMovieBlocksAuto())return;
    if(maroOutingBlocked())return ;
    if(maroCuriosityActive()||maroScreenTapActive()||snackRequestActive()||snackPetLocked())return;
    if(restIsVisible()){petSeatedMaro();return;}
    if(maroSoundOpen)return;
    if(chatBusy()&&!napActive&&!napTransitioning)return;
    if (napTransitioning) return;           // おひるね出入りのクロスフェード中はなでなで無効
